<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:BTokenGUI.ViewModels"
        xmlns:views="using:BTokenGUI.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="BTokenGUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="BToken"
        Background="{StaticResource BrushWindowBackground}">
  <ScrollViewer x:Name="ScrollZoom" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <LayoutTransformControl x:Name="LayoutZoom">
      <LayoutTransformControl.LayoutTransform>
        <ScaleTransform />
      </LayoutTransformControl.LayoutTransform>
      <Grid Width="{Binding $parent[Window].ClientSize.Width}" Height="{Binding $parent[Window].ClientSize.Height}">
        <Grid ColumnDefinitions="7*,6*,7*,6*">
          <views:NodeView Grid.Column="0" />
          <views:NetworksView Grid.Column="1" />
          <views:MiningView Grid.Column="2" />
          <views:WalletView Grid.Column="3" />
        </Grid>
        <views:WithdrawalView />
        <views:ConverterView />
        <views:AnchorsView />
        <views:TXsPoolView />
      </Grid>
    </LayoutTransformControl>
  </ScrollViewer>
</Window>
