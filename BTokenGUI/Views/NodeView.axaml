<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BTokenGUI.ViewModels"
             x:Class="BTokenGUI.Views.NodeView"
             x:DataType="vm:MainViewModel">
  <Border Classes="Panel">
    <StackPanel Spacing="10" Margin="20">
      <SelectableTextBlock Text="Node" FontWeight="Bold" />
      <SelectableTextBlock Text="{Binding StatusConnection}" />
    </StackPanel>
  </Border>
</UserControl>
