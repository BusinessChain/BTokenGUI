<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BTokenGUI.ViewModels"
             xmlns:models="using:BTokenGUI.Models"
             x:Class="BTokenGUI.Views.WithdrawalView"
             x:DataType="vm:MainViewModel">
  <Grid DataContext="{Binding Mining}" x:DataType="models:Mining" IsVisible="{Binding WalletWithdrawal, Converter={x:Static ObjectConverters.IsNotNull}}">
    <Border Background="#99000000" />
    <Border Classes="Panel" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" MaxWidth="480" Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Center">
      <StackPanel Spacing="12" Margin="16">
        <Grid ColumnDefinitions="*,Auto">
          <SelectableTextBlock Grid.Column="0" Text="{Binding WalletWithdrawal.TitleWithdrawal}" FontWeight="Bold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="Close" Command="{Binding CancelWithdrawalCommand}" />
        </Grid>
        <SelectableTextBlock Text="{Binding WalletWithdrawal.Address, StringFormat='Funding address: {0}'}" IsVisible="{Binding WalletWithdrawal.Address, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
        <SelectableTextBlock Text="{Binding WalletWithdrawal.Funds, StringFormat='Funds: {0}', TargetNullValue='Funds: unknown while the accounts synchronize'}" TextWrapping="Wrap" />
        <Border Classes="Panel" Margin="0">
          <StackPanel Spacing="12" Margin="12">
            <SelectableTextBlock Text="Withdrawal" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="12">
              <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="Address" VerticalAlignment="Center" />
              <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding AddressWithdrawal}" />
              <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="Fee in satoshis" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="1" Grid.Column="0" Value="{Binding FeeWithdrawal}" ShowButtonSpinner="False" FormatString="0" ParsingNumberStyle="Integer" Minimum="0" />
            </Grid>
            <CheckBox Content="auto" IsChecked="{Binding IsWithdrawalAutoChosen}" IsVisible="{Binding WalletWithdrawal.IsAutoOffered, FallbackValue=False}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsWithdrawalAutoChosen}">
              <SelectableTextBlock Grid.Column="1" Text="Automatic withdrawal level" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="0" Value="{Binding LevelWithdrawalAuto}" ShowButtonSpinner="False" FormatString="0" ParsingNumberStyle="Integer" Minimum="0" />
            </Grid>
            <SelectableTextBlock Text="{Binding ErrorWithdrawal}" IsVisible="{Binding ErrorWithdrawal, Converter={x:Static ObjectConverters.IsNotNull}}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="OK" Command="{Binding ApplyWithdrawalAutoCommand}" IsVisible="{Binding WalletWithdrawal.IsAutoOffered, FallbackValue=False}" />
              <Button Content="Send" Command="{Binding WithdrawCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
