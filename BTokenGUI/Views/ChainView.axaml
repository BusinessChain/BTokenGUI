<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BTokenGUI.ViewModels"
             xmlns:models="using:BTokenGUI.Models"
             x:Class="BTokenGUI.Views.ChainView"
             x:DataType="vm:MainViewModel">
  <Border Classes="Panel">
    <DockPanel Margin="20">
      <SelectableTextBlock DockPanel.Dock="Top" Text="Chain" FontWeight="Bold" Margin="0,0,0,10" />
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Blockchains}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Blockchain">
              <Border Classes="Panel">
                <StackPanel Spacing="6" Margin="10">
                  <SelectableTextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <ContentControl Content="{Binding MinerBlockchain}">
                    <ContentControl.ContentTemplate>
                      <DataTemplate x:DataType="models:Blockchain+Miner">
                        <Border Classes="Panel">
                          <StackPanel Spacing="6" Margin="10">
                            <SelectableTextBlock Text="Miner" FontWeight="Bold" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" RowSpacing="6" ColumnSpacing="12">
                              <SelectableTextBlock Grid.Row="0" Grid.Column="0" Text="Budget in satoshis per 10 minutes" VerticalAlignment="Center" />
                              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Budget}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Button Content="Start" Command="{Binding StartMiningCommand}" />
                              <Button Content="Stop" Command="{Binding StopMiningCommand}" />
                              <SelectableTextBlock Text="{Binding HintSync}" VerticalAlignment="Center" />
                            </StackPanel>
                            <SelectableTextBlock Text="{Binding Funds, StringFormat='Funds: {0}'}" TextWrapping="Wrap" />
                            <SelectableTextBlock Text="{Binding AddressFunding, StringFormat='Funding address: {0}'}" TextWrapping="Wrap" />
                            <SelectableTextBlock Text="{Binding StatusMining}" TextWrapping="Wrap" />
                            <SelectableTextBlock Text="{Binding StateRoundLast}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ContentControl.ContentTemplate>
                  </ContentControl>
                  <Border Classes="Panel" IsVisible="{Binding AddressReceiving, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="6" Margin="10">
                      <SelectableTextBlock Text="Wallet" FontWeight="Bold" />
                      <SelectableTextBlock Text="{Binding AddressReceiving, StringFormat='Receiving address: {0}'}" TextWrapping="Wrap" />
                      <SelectableTextBlock Text="{Binding BalanceWallet, StringFormat='Balance: {0}'}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:Blockchain+Block">
                        <Expander HorizontalAlignment="Stretch" Margin="0,0,0,6">
                          <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                              <SelectableTextBlock Text="{Binding Height}" FontWeight="SemiBold" />
                              <SelectableTextBlock Text="{Binding HashShort}" />
                            </StackPanel>
                          </Expander.Header>
                          <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="models:Blockchain+Block+Field">
                                <Grid ColumnDefinitions="140,*" Margin="0,2">
                                  <SelectableTextBlock Grid.Column="0" Text="{Binding Name}" />
                                  <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Expander>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
