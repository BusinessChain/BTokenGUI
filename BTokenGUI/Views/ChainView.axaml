<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BTokenGUI.ViewModels"
             xmlns:models="using:BTokenGUI.Models"
             x:Class="BTokenGUI.Views.ChainView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <Style Selector="Border.vessel">
      <Setter Property="DockPanel.Dock" Value="Top" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="160" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="Border.vessel > ItemsControl">
      <Setter Property="Margin" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="DockPanel.tipLast > Border.vessel">
      <Setter Property="DockPanel.Dock" Value="Bottom" />
    </Style>
    <Style Selector=":is(Control).flying">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ItemsControl.flights">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <Canvas />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ItemsControl.flights :is(Control).flying">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Panel.glowing > Path.glow">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.4" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Panel.exploding">
      <Style.Animations>
        <Animation Duration="0:0:0.6" FillMode="Forward" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="ScaleTransform.ScaleX" Value="2.5" />
            <Setter Property="ScaleTransform.ScaleY" Value="2.5" />
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Panel.exploding > Path.flash">
      <Style.Animations>
        <Animation Duration="0:0:0.3" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="30%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <DataTemplate x:Key="TemplateField" x:DataType="models:Blockchain+Block+Field">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,2">
        <SelectableTextBlock Grid.Column="0" Text="{Binding Value}" TextWrapping="Wrap" />
        <SelectableTextBlock Grid.Column="1" Text="{Binding Name}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="TemplateEntry">
      <Border Classes="Panel" Margin="0,0,0,6">
        <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource TemplateField}" Margin="8" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="TemplateTX" x:DataType="models:Blockchain+TX">
      <StackPanel Spacing="12">
        <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource TemplateField}" />
        <SelectableTextBlock Text="Inputs" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource TemplateEntry}" />
        <SelectableTextBlock Text="Outputs" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Outputs}" ItemTemplate="{StaticResource TemplateEntry}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateBlockDetails" x:DataType="models:Blockchain+Block">
      <StackPanel Spacing="12">
        <ItemsControl ItemsSource="{Binding Fields}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Blockchain+Block+Field">
              <Grid ColumnDefinitions="140,*" Margin="0,2">
                <SelectableTextBlock Grid.Column="0" Text="{Binding Name}" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <SelectableTextBlock Text="TXs" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding TXs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Blockchain+TX">
              <Border Classes="Panel" Margin="0,0,0,6">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateTX}" Margin="8" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateAnchor" x:DataType="models:Blockchain+Anchor">
      <Panel Width="72" Height="72" Margin="-20" Classes.glowing="{Binding !IsRotten}" Classes.flying="{Binding IsFlying}">
        <Path Classes="glow" Data="M28,24 L44,24 L49,32 L36,48 L23,32 Z" Fill="{Binding BrushPair}" Stroke="{Binding BrushPair}" StrokeThickness="5" StrokeJoin="Round" Opacity="0" IsHitTestVisible="False">
          <Path.Effect>
            <BlurEffect Radius="8" />
          </Path.Effect>
        </Path>
        <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button.Flyout>
            <Flyout>
              <StackPanel Spacing="12" MaxWidth="420">
                <SelectableTextBlock Text="Anchor TX" FontWeight="Bold" />
                <SelectableTextBlock Text="This anchor missed its Bitcoin block." IsVisible="{Binding IsMissed}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                <ContentControl Content="{Binding TX}" ContentTemplate="{StaticResource TemplateTX}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <Path Fill="{Binding BrushPair}" Width="28" Height="28" Data="F1 M6,2 L22,2 L27,10 L14,26 L1,10 Z M1,10 L27,10 M6,2 L10,10 L14,2 L18,10 L22,2 M10,10 L14,26 L18,10" Stroke="#40FFFFFF" StrokeThickness="1" StrokeJoin="Round" />
        </Button>
      </Panel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateBlockMined" x:DataType="models:Blockchain+Block">
      <Panel Width="28" Height="28" Margin="2" Classes.flying="{Binding IsFlying}" Classes.exploding="{Binding IsExploding}" RenderTransformOrigin="50%,50%">
        <Panel.RenderTransform>
          <ScaleTransform />
        </Panel.RenderTransform>
        <Path Classes="flash" Data="M14,2 L26,8 L26,20 L14,26 L2,20 L2,8 Z" Fill="White" Opacity="0" IsHitTestVisible="False">
          <Path.Effect>
            <BlurEffect Radius="8" />
          </Path.Effect>
        </Path>
        <Button Padding="0" Background="Transparent" BorderThickness="0">
          <Button.Flyout>
            <Flyout Opening="LoadTXsFlyout">
              <ScrollViewer MaxHeight="600">
                <StackPanel Spacing="12" MaxWidth="420">
                  <SelectableTextBlock Text="Mined block" FontWeight="Bold" />
                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateBlockDetails}" />
                </StackPanel>
              </ScrollViewer>
            </Flyout>
          </Button.Flyout>
          <Panel Width="28" Height="28">
            <Path Data="M14,2 L26,8 L26,20 L14,26 L2,20 L2,8 Z" Fill="{Binding BrushPair}" Stroke="#40FFFFFF" StrokeThickness="1" StrokeJoin="Round" />
            <Path Data="M2,8 L14,14 L14,26 L2,20 Z" Fill="#40000000" Stroke="#40FFFFFF" StrokeThickness="1" StrokeJoin="Round" />
            <Path Data="M14,14 L26,8 L26,20 L14,26 Z" Fill="#80000000" Stroke="#40FFFFFF" StrokeThickness="1" StrokeJoin="Round" />
          </Panel>
        </Button>
      </Panel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateBlockchain" x:DataType="models:Blockchain">
      <Border Classes="Panel">
        <DockPanel Classes.tipLast="{Binding IsTipLast}" Margin="10">
          <SelectableTextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,6" />
          <Border Classes="Panel vessel" IsVisible="{Binding IsTXPoolVisible}">
            <ItemsControl ItemsSource="{Binding Anchors}" ItemTemplate="{StaticResource TemplateAnchor}" />
          </Border>
          <Border Classes="Panel vessel" IsVisible="{Binding IsBlocksMinedPoolVisible}">
            <ItemsControl ItemsSource="{Binding BlocksMined}" ItemTemplate="{StaticResource TemplateBlockMined}" />
          </Border>
          <ItemsControl ItemsSource="{Binding Blocks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Blockchain+Block">
                <Expander HorizontalAlignment="Stretch" Margin="0,0,0,6" Classes.flying="{Binding IsFlying}" Expanding="LoadTXsExpander">
                  <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <SelectableTextBlock Text="{Binding Height}" FontWeight="SemiBold" />
                      <SelectableTextBlock Text="{Binding HashShort}" />
                      <ItemsControl ItemsSource="{Binding Anchors}" ItemTemplate="{StaticResource TemplateAnchor}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </StackPanel>
                  </Expander.Header>
                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateBlockDetails}" />
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="TemplateWallet" x:DataType="models:Mining+Wallet">
      <Button Command="{Binding OpenPanelCommand}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center">
        <Border Width="40" Height="52" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" ClipToBounds="True">
          <Border Background="{DynamicResource SystemControlHighlightAccentBrush}" RenderTransformOrigin="50%,100%">
            <Border.RenderTransform>
              <ScaleTransform ScaleY="{Binding Filling}" />
            </Border.RenderTransform>
          </Border>
        </Border>
      </Button>
    </DataTemplate>
  </UserControl.Resources>
  <Border Classes="Panel">
    <DockPanel Margin="20">
      <SelectableTextBlock DockPanel.Dock="Top" Text="Chain" FontWeight="Bold" Margin="0,0,0,10" />
      <ScrollViewer>
        <Panel>
          <StackPanel>
            <ContentControl x:Name="ContentBlockchainBitcoin" Content="{Binding BlockchainBitcoin}" ContentTemplate="{StaticResource TemplateBlockchain}" />
            <Border Width="2" Height="20" HorizontalAlignment="Center" Background="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Border Classes="Panel" BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" BorderThickness="2">
              <StackPanel DataContext="{Binding Mining}" x:DataType="models:Mining" Spacing="10" Margin="10">
                <SelectableTextBlock Text="Miner" FontWeight="Bold" HorizontalAlignment="Center" />
                <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="20">
                  <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Width="2" HorizontalAlignment="Center" Background="{DynamicResource SystemControlHighlightAccentBrush}" />
                  <Panel x:Name="PanelConverter" Grid.Row="1" Grid.Column="0" Width="64" Height="56" Margin="-4,-14" HorizontalAlignment="Center" VerticalAlignment="Center" Classes.glowing="{Binding IsMining}">
                    <Path Classes="glow" Data="M8,6 L56,6 L32,48 Z" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0" IsHitTestVisible="False">
                      <Path.Effect>
                        <BlurEffect Radius="8" />
                      </Path.Effect>
                    </Path>
                    <Button Command="{Binding OpenFormConverterCommand}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Panel Width="32" Height="28">
                        <Panel Clip="M0,0 L32,0 L16,28 Z">
                          <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" />
                          <Border Background="{DynamicResource SystemControlHighlightAccentBrush}" RenderTransformOrigin="50%,100%">
                            <Border.RenderTransform>
                              <ScaleTransform ScaleY="{Binding FillingConverter}" />
                            </Border.RenderTransform>
                          </Border>
                        </Panel>
                        <Path Data="M1,1 L31,1 L16,26 Z" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" StrokeJoin="Round" />
                      </Panel>
                    </Button>
                  </Panel>
                  <ContentControl Grid.Row="0" Grid.Column="0" Content="{Binding WalletBitcoin}" ContentTemplate="{StaticResource TemplateWallet}" />
                  <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StateMiner}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <ContentControl Grid.Row="2" Grid.Column="0" Content="{Binding WalletBToken}" ContentTemplate="{StaticResource TemplateWallet}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Width="2" Height="20" HorizontalAlignment="Center" Background="{DynamicResource SystemControlHighlightAccentBrush}" />
            <ContentControl Content="{Binding BlockchainBToken}" ContentTemplate="{StaticResource TemplateBlockchain}" />
          </StackPanel>
          <ItemsControl x:Name="ItemsFlights" Classes="flights" DataContext="{Binding BlockchainBitcoin}" ItemsSource="{Binding Flights}" x:DataType="models:Blockchain" ItemTemplate="{StaticResource TemplateAnchor}" />
          <ItemsControl x:Name="ItemsFlightsBToken" Classes="flights" DataContext="{Binding BlockchainBToken}" ItemsSource="{Binding Flights}" x:DataType="models:Blockchain" ItemTemplate="{StaticResource TemplateBlockMined}" />
        </Panel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
