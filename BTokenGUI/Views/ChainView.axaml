<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BTokenGUI.ViewModels"
             xmlns:models="using:BTokenGUI.Models"
             xmlns:views="using:BTokenGUI.Views"
             x:Class="BTokenGUI.Views.ChainView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <Style Selector="ContentControl.shelf">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="160" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="Margin" Value="36,0,0,38" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Panel Height="58" Margin="0,0,-30,-30" VerticalAlignment="Bottom" Opacity="0.35" IsHitTestVisible="False">
              <Panel.Effect>
                <BlurEffect Radius="8" />
              </Panel.Effect>
              <Path Width="30" HorizontalAlignment="Left" Data="M18,0 L30,0 L30,58 L0,28 L0,18 Z" Fill="Black" />
              <Border Margin="30,0,48,0" Background="Black" />
              <Path Width="48" HorizontalAlignment="Right" Data="M0,0 L18,0 L48,30 L48,40 L30,58 L0,58 Z" Fill="Black" />
            </Panel>
            <TemplatedControl Theme="{StaticResource ThemePlank}" />
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Margin="21,6,21,18" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ContentControl.shelf > ItemsControl">
      <Setter Property="Margin" Value="-40" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" ItemSpacing="6" Margin="40" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="Ellipse.shadowShelf">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="8" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Fill">
        <RadialGradientBrush>
          <GradientStop Offset="0" Color="#B0000000" />
          <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>
      </Setter>
    </Style>
    <Style Selector="ContentControl.shelf Ellipse.shadowShelf">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector=":is(Control).flying">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ItemsControl.flights">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <Canvas />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ItemsControl.flights :is(Control).flying">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Panel.glowing > Path.glow">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Panel.exploding">
      <Style.Animations>
        <Animation Duration="0:0:0.6" FillMode="Forward" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="ScaleTransform.ScaleX" Value="2.5" />
            <Setter Property="ScaleTransform.ScaleY" Value="2.5" />
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Panel.exploding > Path.flash">
      <Style.Animations>
        <Animation Duration="0:0:0.3" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="30%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <StreamGeometry x:Key="GeometryCone">M2,10 A34,5 0 0 1 70,10 L40.5,60 L42,60 L42,67 L30,67 L30,60 L31.5,60 Z</StreamGeometry>
    <StreamGeometry x:Key="GeometryConeInterior">M2,10 A34,5 0 0 1 70,10 L40.5,60 L31.5,60 Z</StreamGeometry>
    <StreamGeometry x:Key="GeometryConeCollar">M30,60 L42,60 L42,67 L30,67 Z</StreamGeometry>
    <StreamGeometry x:Key="GeometryTubeCenter">M36,66 L36,76 C36,94 26,104 8,104 L4,104</StreamGeometry>
    <StreamGeometry x:Key="GeometryTubeConverter">M38,104 L36,104 C29.4,104 24,109.4 24,116 L24,190</StreamGeometry>
    <StreamGeometry x:Key="GeometryTubeAway">M36,76 C36,94 46,104 64,104 L104,104</StreamGeometry>
    <StreamGeometry x:Key="GeometryWallet">M8,2 L60,2 A6,6 0 0 1 66,8 L66,44 A6,6 0 0 1 60,50 L8,50 A6,6 0 0 1 2,44 L2,8 A6,6 0 0 1 8,2 Z</StreamGeometry>
    <LinearGradientBrush x:Key="BrushFadeTube" StartPoint="56,0" EndPoint="104,0">
      <GradientStop Offset="0" Color="Black" />
      <GradientStop Offset="1" Color="Transparent" />
    </LinearGradientBrush>
    <ControlTheme x:Key="ThemeCube" TargetType="ContentControl">
      <Setter Property="Width" Value="72" />
      <Setter Property="Height" Value="98" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Width="52" Height="78" Margin="19,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource BrushWindowBackground}" IsHitTestVisible="False">
              <Border Background="{TemplateBinding BorderBrush}" Opacity="0.36" />
            </Border>
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
            <Panel IsHitTestVisible="False">
              <Path Data="M1,19 L19,1 L71,1 L53,19 Z" Fill="{TemplateBinding BorderBrush}" Opacity="0.68" />
              <Path Data="M1,19 L53,19 L53,97 L1,97 Z" Fill="{TemplateBinding BorderBrush}" Opacity="0.36" />
              <Path Data="M53,19 L71,1 L71,79 L53,97 Z" Fill="{TemplateBinding BorderBrush}" Opacity="0.2" />
              <Path Data="M1,19 L19,1 L71,1 L71,79 L53,97 L1,97 Z M1,19 L53,19 L71,1 M53,19 L53,97" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" StrokeJoin="Round" />
            </Panel>
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="ThemeChip" TargetType="ContentControl">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{TemplateBinding BorderBrush}" Opacity="0.9">
              <Rectangle.Effect>
                <BlurEffect Radius="6" />
              </Rectangle.Effect>
            </Rectangle>
            <Path Data="M10,14 H12 M10,18 H12 M20,14 H22 M20,18 H22 M14,10 V12 M18,10 V12 M14,20 V22 M18,20 V22" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" />
            <Border Width="8" Height="8" CornerRadius="1.5" BorderThickness="0.75" BorderBrush="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" />
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="ThemePlank" TargetType="TemplatedControl">
      <Setter Property="Height" Value="28" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Background" Value="{StaticResource BrushWindowBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Height="18" Margin="1,1,19,0" VerticalAlignment="Top" Background="{TemplateBinding Background}" RenderTransformOrigin="0%,100%">
              <Border.RenderTransform>
                <SkewTransform AngleX="-45" />
              </Border.RenderTransform>
              <Panel>
                <Border Background="{TemplateBinding BorderBrush}" Opacity="0.68" />
                <Border>
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Offset="0" Color="#48000000" />
                      <GradientStop Offset="1" Color="#18FFFFFF" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
              </Panel>
            </Border>
            <Panel Width="20" HorizontalAlignment="Right" Clip="M1,19 L19,1 L19,9 L1,27 Z">
              <Border Background="{TemplateBinding Background}" />
              <Border Background="{TemplateBinding BorderBrush}" Opacity="0.2" />
            </Panel>
            <Border Height="10" Margin="0,18,18,0" VerticalAlignment="Top" CornerRadius="1" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
              <Panel>
                <Border Background="{TemplateBinding BorderBrush}" Opacity="0.36" />
                <Border>
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Offset="0" Color="#18FFFFFF" />
                      <GradientStop Offset="1" Color="#48000000" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
              </Panel>
            </Border>
            <Border Height="2" Margin="18,0,0,0" VerticalAlignment="Top" CornerRadius="1" Background="{TemplateBinding BorderBrush}" />
            <Path Width="20" HorizontalAlignment="Left" Data="M1,19 L19,1" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" StrokeLineCap="Round" />
            <Path Width="20" HorizontalAlignment="Right" Data="M1,19 L19,1 L19,9 L1,27" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="ThemeRail" TargetType="TemplatedControl">
      <Setter Property="Height" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="BorderThickness" Value="0,1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Background="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0.4">
              <Border.OpacityMask>
                <DrawingBrush TileMode="Tile" DestinationRect="0,0,40,10">
                  <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="Black" Geometry="F0 M0,0 H40 V10 H0 Z M16,3 H24 A2,2 0 0 1 24,7 H16 A2,2 0 0 1 16,3 Z" />
                  </DrawingBrush.Drawing>
                </DrawingBrush>
              </Border.OpacityMask>
            </Border>
            <Border BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <DataTemplate x:Key="TemplateField" x:DataType="models:Blockchain+Block+Field">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,2">
        <SelectableTextBlock Grid.Column="0" Text="{Binding Value}" TextWrapping="Wrap" />
        <SelectableTextBlock Grid.Column="1" Text="{Binding Name}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="TemplateEntry">
      <Border Classes="Panel" Margin="0,0,0,6">
        <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource TemplateField}" Margin="8" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="TemplateTX" x:DataType="models:Blockchain+TX">
      <StackPanel Spacing="12">
        <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource TemplateField}" />
        <SelectableTextBlock Text="Inputs" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource TemplateEntry}" />
        <SelectableTextBlock Text="Outputs" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Outputs}" ItemTemplate="{StaticResource TemplateEntry}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateBlockDetails" x:DataType="models:Blockchain+Block">
      <StackPanel Spacing="12">
        <ItemsControl ItemsSource="{Binding Fields}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Blockchain+Block+Field">
              <Grid ColumnDefinitions="140,*" Margin="0,2">
                <SelectableTextBlock Grid.Column="0" Text="{Binding Name}" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <SelectableTextBlock Text="TXs" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding TXs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Blockchain+TX">
              <Border Classes="Panel" Margin="0,0,0,6">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateTX}" Margin="8" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateAnchor" x:DataType="models:Blockchain+Anchor">
      <Panel Width="72" Height="72" Margin="-20" Classes.glowing="{Binding ReasonForNotGlowing, Converter={x:Static ObjectConverters.IsNull}}" Classes.flying="{Binding IsFlying}">
        <Ellipse Classes="shadowShelf" Margin="0,0,0,24" />
        <Path Classes="glow" Data="M30,30 L42,30 L42,42 L30,42 Z" Fill="White" Stroke="White" StrokeThickness="5" StrokeJoin="Round" Opacity="0" IsHitTestVisible="False">
          <Path.Effect>
            <BlurEffect Radius="8" />
          </Path.Effect>
        </Path>
        <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button.Flyout>
            <Flyout>
              <StackPanel Spacing="12" MaxWidth="420">
                <SelectableTextBlock Text="Anchor TX" FontWeight="Bold" />
                <SelectableTextBlock Text="{Binding ReasonForNotGlowing}" IsVisible="{Binding ReasonForNotGlowing, Converter={x:Static ObjectConverters.IsNotNull}}" Foreground="#AC7045" TextWrapping="Wrap" />
                <ContentControl Content="{Binding TX}" ContentTemplate="{StaticResource TemplateTX}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <ContentControl Theme="{StaticResource ThemeChip}" BorderBrush="{Binding BrushPair}" Foreground="{Binding BrushPair}" Background="{Binding BrushPair}">
            <Ellipse Width="4" Height="4" Stroke="#FFF6DC" StrokeThickness="1" />
          </ContentControl>
        </Button>
      </Panel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateBlockMined" x:DataType="models:Blockchain+Block">
      <Panel Width="28" Height="32" Margin="2,0" Classes.flying="{Binding IsFlying}" Classes.exploding="{Binding IsExploding}" RenderTransformOrigin="50%,50%">
        <Panel.RenderTransform>
          <ScaleTransform />
        </Panel.RenderTransform>
        <Ellipse Classes="shadowShelf" Margin="0,0,4,-3" />
        <Path Classes="flash" Width="23" Height="30" Data="M0.5,6.5 L6.5,0.5 L22.5,0.5 L22.5,23.5 L16.5,29.5 L0.5,29.5 Z" Fill="White" Opacity="0" IsHitTestVisible="False">
          <Path.Effect>
            <BlurEffect Radius="8" />
          </Path.Effect>
        </Path>
        <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button.Flyout>
            <Flyout Opening="LoadTXsFlyout">
              <ScrollViewer MaxHeight="600">
                <StackPanel Spacing="12" MaxWidth="420">
                  <SelectableTextBlock Text="Mined block" FontWeight="Bold" />
                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateBlockDetails}" />
                </StackPanel>
              </ScrollViewer>
            </Flyout>
          </Button.Flyout>
          <Panel Width="23" Height="30">
            <Path Data="M6.5,0.5 L22.5,0.5 L22.5,23.5 L6.5,23.5 Z" Fill="{StaticResource BrushWindowBackground}" />
            <Path Data="M6.5,0.5 L22.5,0.5 L22.5,23.5 L6.5,23.5 Z" Fill="{Binding BrushPair}" Opacity="0.36" />
            <Path Data="M0.5,6.5 L6.5,0.5 L22.5,0.5 L16.5,6.5 Z" Fill="{Binding BrushPair}" Opacity="0.68" />
            <Path Data="M0.5,6.5 L16.5,6.5 L16.5,29.5 L0.5,29.5 Z" Fill="{Binding BrushPair}" Opacity="0.36" />
            <Path Data="M16.5,6.5 L22.5,0.5 L22.5,23.5 L16.5,29.5 Z" Fill="{Binding BrushPair}" Opacity="0.2" />
            <Path Data="M0.5,6.5 L6.5,0.5 L22.5,0.5 L22.5,23.5 L16.5,29.5 L0.5,29.5 Z M0.5,6.5 L16.5,6.5 L22.5,0.5 M16.5,6.5 L16.5,29.5" Stroke="{Binding BrushPair}" StrokeThickness="1" StrokeJoin="Round" />
          </Panel>
        </Button>
      </Panel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateChip" x:DataType="models:Blockchain+Chip">
      <Panel Width="32" Height="32" Classes.flying="{Binding IsFlying}" Classes.exploding="{Binding IsExploding}" RenderTransformOrigin="50%,50%">
        <Panel.RenderTransform>
          <ScaleTransform />
        </Panel.RenderTransform>
        <ContentControl Theme="{StaticResource ThemeChip}" BorderBrush="#FF8A1F" Foreground="#FFC46B">
          <ContentControl.Background>
            <RadialGradientBrush>
              <GradientStop Offset="0" Color="#FFD27A" />
              <GradientStop Offset="1" Color="#FF6A00" />
            </RadialGradientBrush>
          </ContentControl.Background>
          <Rectangle Width="3" Height="3" Fill="#FFF6DC" />
        </ContentControl>
        <Path Classes="flash" Data="M10,10 L22,10 L22,22 L10,22 Z" Fill="White" Opacity="0">
          <Path.Effect>
            <BlurEffect Radius="6" />
          </Path.Effect>
        </Path>
      </Panel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateBlockchain" x:DataType="models:Blockchain">
      <Border Classes="Panel" BorderThickness="0" Background="Transparent">
        <DockPanel Margin="10">
          <SelectableTextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,6" />
          <Grid ColumnDefinitions="3*,Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,40,0">
            <Panel Classes="shelves" Grid.Column="1" Width="800" Margin="-400,0,-343,0" HorizontalAlignment="Right">
              <ContentControl Classes="shelf" IsVisible="{Binding IsTXPoolVisible}">
                <ItemsControl ItemsSource="{Binding Anchors}" ItemTemplate="{StaticResource TemplateAnchor}" />
              </ContentControl>
              <ContentControl Classes="shelf" IsVisible="{Binding IsBlocksMinedPoolVisible}">
                <ItemsControl ItemsSource="{Binding BlocksMined}" ItemTemplate="{StaticResource TemplateBlockMined}" />
              </ContentControl>
            </Panel>
            <Panel Grid.Row="1" Grid.Column="0" Margin="0,0,0,40" ClipToBounds="True">
              <Panel Width="160" Margin="-160,0,0,0" HorizontalAlignment="Right" IsHitTestVisible="False">
                <Panel.OpacityMask>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="Transparent" />
                    <GradientStop Offset="1" Color="Black" />
                  </LinearGradientBrush>
                </Panel.OpacityMask>
                <TemplatedControl Theme="{StaticResource ThemeRail}" />
                <ContentControl Theme="{StaticResource ThemeCube}" BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0.5" Margin="52,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
              </Panel>
            </Panel>
            <Panel Grid.Row="1" Grid.Column="1">
              <TemplatedControl Theme="{StaticResource ThemeRail}" BorderThickness="0,1,1,1" Margin="0,0,0,40" />
              <ItemsControl Classes="blocks" ItemsSource="{Binding Blocks}" Margin="0,-36,-28,0" ContainerPrepared="ExtendTip" ContainerClearing="PresentBlockLeaving">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="36" Margin="0,36,40,40" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:Blockchain+Block">
                    <Panel Width="72" Height="98" Classes.flying="{Binding IsFlying}">
                      <Path Data="M1,19 L19,1 L71,1 L101,31 L101,109 L83,127 L31,127 L1,97 Z" Fill="Black" Opacity="0.35" IsHitTestVisible="False">
                        <Path.Effect>
                          <BlurEffect Radius="8" />
                        </Path.Effect>
                      </Path>
                      <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Button.Flyout>
                          <Flyout Opening="LoadTXsFlyout">
                            <ScrollViewer MaxHeight="600">
                              <StackPanel Spacing="12" MaxWidth="420">
                                <SelectableTextBlock Text="Block" FontWeight="Bold" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateBlockDetails}" />
                              </StackPanel>
                            </ScrollViewer>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                      <ContentControl Theme="{StaticResource ThemeCube}" BorderBrush="{Binding BrushPair, TargetNullValue={StaticResource SystemControlHighlightAccentBrush}}">
                        <ItemsControl ItemsSource="{Binding Anchors}" ItemTemplate="{StaticResource TemplateAnchor}" Width="52" Height="78" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                          <ItemsControl.ItemContainerTheme>
                            <ControlTheme TargetType="ContentPresenter">
                              <Setter Property="Margin" Value="0,-8" />
                            </ControlTheme>
                          </ItemsControl.ItemContainerTheme>
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>
                      </ContentControl>
                      <TextBlock Text="{Binding Height}" Margin="0,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" FontWeight="Bold" Foreground="White" IsHitTestVisible="False">
                        <TextBlock.Effect>
                          <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="3" Color="Black" Opacity="1" />
                        </TextBlock.Effect>
                      </TextBlock>
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
            <Panel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,76,0" ClipToBounds="True" IsHitTestVisible="False">
              <Canvas>
                <Grid Width="{Binding $parent[DockPanel].Bounds.Width}" ColumnDefinitions="*,*">
                  <Panel Grid.Column="1" Height="8" Margin="12,100,0,0" VerticalAlignment="Top" Classes.glowing="{Binding Tank.IsAutoActive}">
                    <Border Background="{DynamicResource SystemControlHighlightAccentBrush}" />
                    <Border Height="5" Background="{StaticResource BrushWindowBackground}" />
                    <Border Height="5" Background="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0.36" />
                    <Path Classes="glow" Data="M0,0 H1 V1 H0 Z" Stretch="Fill" Height="6" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0" IsVisible="{Binding Tank.IsAutoToWalletGUI}">
                      <Path.Effect>
                        <BlurEffect Radius="6" />
                      </Path.Effect>
                    </Path>
                  </Panel>
                </Grid>
              </Canvas>
            </Panel>
            <Panel Grid.Row="2" Grid.ColumnSpan="3" Width="48" Height="200" Margin="0,0,-40,-200" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False" IsVisible="{Binding Tank.IsFeedingConverter}">
              <Path Data="{StaticResource GeometryTubeConverter}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="8" />
              <Path Data="{StaticResource GeometryTubeConverter}" Stroke="{StaticResource BrushWindowBackground}" StrokeThickness="5" />
              <Path Data="{StaticResource GeometryTubeConverter}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="5" Opacity="0.36" />
            </Panel>
            <Panel Grid.Row="2" Grid.ColumnSpan="3" Width="68" Height="52" Margin="0,78,-40,0" HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding !Tank.IsFeedingConverter}">
              <Path Data="{StaticResource GeometryWallet}" Margin="10,10,-10,-10" Fill="Black" Opacity="0.35" IsHitTestVisible="False">
                <Path.Effect>
                  <BlurEffect Radius="8" />
                </Path.Effect>
              </Path>
              <Button Command="{Binding $parent[views:ChainView].((vm:MainViewModel)DataContext).Wallet.ActivateViewCommand}" Width="64" Height="48" Margin="2,2,0,0" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Top" />
              <Panel IsHitTestVisible="False">
                <Path Data="{StaticResource GeometryWallet}" Fill="{StaticResource BrushWindowBackground}" />
                <Path Data="{StaticResource GeometryWallet}" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0.36" />
                <Path Data="{StaticResource GeometryWallet}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" StrokeJoin="Round" />
                <Path Data="M66,14 L46,14 A6,6 0 0 0 40,20 L40,32 A6,6 0 0 0 46,38 L66,38" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" StrokeJoin="Round" />
                <Path Data="M47,26 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0" Fill="White" Opacity="0.8" />
              </Panel>
            </Panel>
            <Panel Grid.Row="2" Grid.Column="1" Width="72" Height="112" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Top" Classes.glowing="{Binding Tank.IsAutoActive}">
              <Path Data="{StaticResource GeometryCone}" Margin="10,10,-10,-10" Fill="Black" Opacity="0.35" IsHitTestVisible="False">
                <Path.Effect>
                  <BlurEffect Radius="8" />
                </Path.Effect>
              </Path>
              <Panel IsHitTestVisible="False">
                <Path Data="{StaticResource GeometryTubeCenter}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="8" />
                <Path Data="{StaticResource GeometryTubeAway}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="8" OpacityMask="{StaticResource BrushFadeTube}" IsVisible="{Binding !Tank.IsFeedingConverter}" />
                <Path Data="{StaticResource GeometryTubeCenter}" Stroke="{StaticResource BrushWindowBackground}" StrokeThickness="5" />
                <Path Data="{StaticResource GeometryTubeAway}" Stroke="{StaticResource BrushWindowBackground}" StrokeThickness="5" OpacityMask="{StaticResource BrushFadeTube}" IsVisible="{Binding !Tank.IsFeedingConverter}" />
                <Path Data="{StaticResource GeometryTubeCenter}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="5" Opacity="0.36" />
                <Path Data="{StaticResource GeometryTubeAway}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="5" Opacity="0.36" OpacityMask="{StaticResource BrushFadeTube}" IsVisible="{Binding !Tank.IsFeedingConverter}" />
              </Panel>
              <Path Classes="glow" Data="{StaticResource GeometryTubeCenter}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="6" Opacity="0" IsVisible="{Binding Tank.IsAutoToWalletGUI}" IsHitTestVisible="False">
                <Path.Effect>
                  <BlurEffect Radius="6" />
                </Path.Effect>
              </Path>
              <Path Classes="glow" Data="{StaticResource GeometryTubeAway}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="6" Opacity="0" OpacityMask="{StaticResource BrushFadeTube}" IsVisible="{Binding !Tank.IsAutoToWalletGUI}" IsHitTestVisible="False">
                <Path.Effect>
                  <BlurEffect Radius="6" />
                </Path.Effect>
              </Path>
              <Button Command="{Binding Tank.OpenPanelCommand}" Height="68" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
              <Panel IsHitTestVisible="False">
                <Path Data="{StaticResource GeometryConeInterior}" Fill="{StaticResource BrushWindowBackground}" Opacity="0.6" />
                <Path Data="{StaticResource GeometryConeInterior}" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0.12" />
                <Path Data="M2,10 A34,5 0 0 1 70,10" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" Opacity="0.6" />
              </Panel>
              <Path Data="{StaticResource GeometryConeInterior}" Fill="#FF8A1F" Opacity="0.9" RenderTransformOrigin="36,60" IsVisible="{Binding !Tank.IsFeedingConverter}" IsHitTestVisible="False">
                <Path.RenderTransform>
                  <ScaleTransform ScaleX="{Binding FillingPowder}" ScaleY="{Binding FillingPowder}" />
                </Path.RenderTransform>
              </Path>
              <Path Classes="glow" Data="{StaticResource GeometryCone}" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="4" StrokeJoin="Round" Opacity="0" IsHitTestVisible="False">
                <Path.Effect>
                  <BlurEffect Radius="10" />
                </Path.Effect>
              </Path>
              <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource TemplateChip}" Height="140" Margin="-40,-40,-40,0" VerticalAlignment="Top" IsHitTestVisible="False">
                <ItemsControl.ItemContainerTheme>
                  <ControlTheme TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="-9.5,-10.5" />
                  </ControlTheme>
                </ItemsControl.ItemContainerTheme>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <views:PanelHeap Margin="40" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <Panel IsHitTestVisible="False">
                <Path Data="M2,10 A34,5 0 0 0 70,10 L40.5,60 L31.5,60 Z">
                  <Path.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                      <GradientStop Offset="0" Color="#30FFFFFF" />
                      <GradientStop Offset="0.35" Color="#08FFFFFF" />
                      <GradientStop Offset="0.7" Color="#00000000" />
                      <GradientStop Offset="1" Color="#40000000" />
                    </LinearGradientBrush>
                  </Path.Fill>
                </Path>
                <Path Data="M8,16 L30,53" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" Opacity="0.25" />
                <Path Data="M12,27 A24,3.5 0 0 0 60,27 M25,49 A11,1.6 0 0 0 47,49" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="1.5" Opacity="0.7" />
                <Path Data="M66.5,16 H70.5 M60,27 H64 M53.5,38 H57.5 M47,49 H51" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="1" />
                <Path Data="M2,10 L31.5,60 M70,10 L40.5,60" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" StrokeLineCap="Round" />
                <Path Data="M2,10 A34,5 0 0 0 70,10" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="3" StrokeLineCap="Round" />
                <Path Data="M64.4,12.5 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0 M52,14.3 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0 M35,15 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0 M18,14.3 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0 M5.6,12.5 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0" Fill="White" Opacity="0.7" />
                <Path Data="{StaticResource GeometryConeCollar}" Fill="{StaticResource BrushWindowBackground}" />
                <Path Data="{StaticResource GeometryConeCollar}" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0.36" />
                <Path Data="{StaticResource GeometryConeCollar}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" StrokeJoin="Round" />
              </Panel>
            </Panel>
          </Grid>
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Border Classes="Panel">
    <Border.Background>
      <RadialGradientBrush Center="0%,0%" GradientOrigin="0%,0%" RadiusX="100%" RadiusY="100%">
        <GradientStop Offset="0" Color="#60FFFFFF" />
        <GradientStop Offset="1" Color="#06FFFFFF" />
      </RadialGradientBrush>
    </Border.Background>
    <DockPanel Margin="20">
      <SelectableTextBlock DockPanel.Dock="Top" Text="Chain" FontWeight="Bold" Margin="0,0,0,10" />
      <ScrollViewer VerticalScrollBarVisibility="Hidden" IsVisible="{Binding BlockchainBToken.IsPlaced}">
        <Panel>
          <Panel.DataTemplates>
            <DataTemplate DataType="models:Blockchain+Anchor">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateAnchor}" />
            </DataTemplate>
            <DataTemplate DataType="models:Blockchain+Block">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateBlockMined}" />
            </DataTemplate>
            <DataTemplate DataType="models:Blockchain+Chip">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateChip}" />
            </DataTemplate>
          </Panel.DataTemplates>
          <StackPanel>
            <ContentControl x:Name="ContentBlockchainBitcoin" Content="{Binding BlockchainBitcoin}" ContentTemplate="{StaticResource TemplateBlockchain}" />
            <Border Classes="Panel" BorderThickness="0" Background="Transparent">
              <StackPanel DataContext="{Binding Mining}" x:DataType="models:Mining" Spacing="10" Margin="10">
                <SelectableTextBlock Text="Miner" FontWeight="Bold" />
                <Panel x:Name="PanelConverter" Width="128" Height="112" Margin="0,-28" HorizontalAlignment="Center" Classes.glowing="{Binding IsMining}">
                  <Path Classes="glow" Data="M16,12 L112,12 L64,96 Z" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0" IsHitTestVisible="False">
                    <Path.Effect>
                      <BlurEffect Radius="16" />
                    </Path.Effect>
                  </Path>
                  <Button Command="{Binding OpenFormConverterCommand}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Panel Width="64" Height="56">
                      <Panel Clip="M0,0 L64,0 L32,56 Z">
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" />
                        <Border Background="{DynamicResource SystemControlHighlightAccentBrush}" RenderTransformOrigin="50%,100%">
                          <Border.RenderTransform>
                            <ScaleTransform ScaleY="{Binding FillingConverter}" />
                          </Border.RenderTransform>
                        </Border>
                      </Panel>
                      <Path Data="M1,1 L63,1 L32,54 Z" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" StrokeJoin="Round" />
                    </Panel>
                  </Button>
                </Panel>
                <SelectableTextBlock Text="{Binding StateMiner}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
            <ContentControl Content="{Binding BlockchainBToken}" ContentTemplate="{StaticResource TemplateBlockchain}" />
          </StackPanel>
          <ItemsControl x:Name="ItemsFlights" Classes="flights" DataContext="{Binding BlockchainBitcoin}" ItemsSource="{Binding Flights}" x:DataType="models:Blockchain" />
          <ItemsControl x:Name="ItemsFlightsBToken" Classes="flights" DataContext="{Binding BlockchainBToken}" ItemsSource="{Binding Flights}" x:DataType="models:Blockchain" />
        </Panel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
