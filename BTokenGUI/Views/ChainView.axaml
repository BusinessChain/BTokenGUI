<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BTokenGUI.ViewModels"
             xmlns:models="using:BTokenGUI.Models"
             x:Class="BTokenGUI.Views.ChainView"
             x:DataType="vm:MainViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="TemplateBlockchain" x:DataType="models:Blockchain">
      <Border Classes="Panel">
        <StackPanel Spacing="6" Margin="10">
          <SelectableTextBlock Text="{Binding Name}" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding Blocks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Blockchain+Block">
                <Expander HorizontalAlignment="Stretch" Margin="0,0,0,6">
                  <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <SelectableTextBlock Text="{Binding Height}" FontWeight="SemiBold" />
                      <SelectableTextBlock Text="{Binding HashShort}" />
                    </StackPanel>
                  </Expander.Header>
                  <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:Blockchain+Block+Field">
                        <Grid ColumnDefinitions="140,*" Margin="0,2">
                          <SelectableTextBlock Grid.Column="0" Text="{Binding Name}" />
                          <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="TemplateWallet" x:DataType="models:Mining+Wallet">
      <Button Command="{Binding OpenPanelCommand}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center">
        <Border Width="40" Height="52" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" ClipToBounds="True">
          <Border Background="{DynamicResource SystemControlHighlightAccentBrush}" RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
              <ScaleTransform ScaleY="{Binding Filling}" />
            </Border.RenderTransform>
          </Border>
        </Border>
      </Button>
    </DataTemplate>
  </UserControl.Resources>
  <Border Classes="Panel">
    <DockPanel Margin="20">
      <SelectableTextBlock DockPanel.Dock="Top" Text="Chain" FontWeight="Bold" Margin="0,0,0,10" />
      <ScrollViewer>
        <StackPanel>
          <ContentControl Content="{Binding BlockchainBitcoin}" ContentTemplate="{StaticResource TemplateBlockchain}" />
          <Border Width="2" Height="20" HorizontalAlignment="Center" Background="{DynamicResource SystemControlHighlightAccentBrush}" />
          <Border Classes="Panel" BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" BorderThickness="2">
            <StackPanel DataContext="{Binding Mining}" x:DataType="models:Mining" Spacing="10" Margin="10">
              <SelectableTextBlock Text="Mining" FontWeight="Bold" HorizontalAlignment="Center" />
              <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="20">
                <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Width="2" HorizontalAlignment="Center" Background="{DynamicResource SystemControlHighlightAccentBrush}" />
                <Panel Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Width="32" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Panel Clip="M0,0 L32,0 L16,28 Z">
                    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" />
                    <Border Background="{DynamicResource SystemControlHighlightAccentBrush}" RenderTransformOrigin="0.5,1">
                      <Border.RenderTransform>
                        <ScaleTransform ScaleY="{Binding FillingConverter}" />
                      </Border.RenderTransform>
                    </Border>
                  </Panel>
                  <Path Data="M1,1 L31,1 L16,26 Z" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" StrokeJoin="Round" />
                </Panel>
                <ContentControl Grid.Row="0" Grid.Column="0" Content="{Binding WalletBitcoin}" ContentTemplate="{StaticResource TemplateWallet}" />
                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <SelectableTextBlock Grid.Column="1" Text="Budget in satoshis per 10 minutes" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="0" Value="{Binding Budget}" ShowButtonSpinner="False" FormatString="0" ParsingNumberStyle="Integer" Minimum="0" />
                </Grid>
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                  <Button Command="{Binding ToggleMiningCommand}" HorizontalAlignment="Center">
                    <Panel>
                      <TextBlock Text="Start" IsVisible="{Binding !IsMining}" />
                      <TextBlock Text="Stop" IsVisible="{Binding IsMining}" />
                    </Panel>
                  </Button>
                  <SelectableTextBlock Text="{Binding StateMiner}" TextWrapping="Wrap" />
                </StackPanel>
                <ContentControl Grid.Row="3" Grid.Column="0" Content="{Binding WalletBToken}" ContentTemplate="{StaticResource TemplateWallet}" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Width="2" Height="20" HorizontalAlignment="Center" Background="{DynamicResource SystemControlHighlightAccentBrush}" />
          <ContentControl Content="{Binding BlockchainBToken}" ContentTemplate="{StaticResource TemplateBlockchain}" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
