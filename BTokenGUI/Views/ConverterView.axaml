<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BTokenGUI.ViewModels"
             xmlns:models="using:BTokenGUI.Models"
             x:Class="BTokenGUI.Views.ConverterView"
             x:DataType="vm:MainViewModel">
  <Grid DataContext="{Binding Mining}" x:DataType="models:Mining" IsVisible="{Binding IsFormConverterOpen}">
    <Border Background="#99000000" />
    <Border Classes="Panel" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" MaxWidth="480" Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Center">
      <StackPanel Spacing="12" Margin="16">
        <Grid ColumnDefinitions="*,Auto">
          <SelectableTextBlock Grid.Column="0" Text="Converter budget" FontWeight="Bold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="Close" Command="{Binding CloseFormConverterCommand}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <SelectableTextBlock Grid.Column="1" Text="sats / day" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="0" Value="{Binding Budget}" ShowButtonSpinner="False" FormatString="0" ParsingNumberStyle="Integer" Minimum="0" />
        </Grid>
        <SelectableTextBlock Text="{Binding StateMiner}" TextWrapping="Wrap" />
        <Button Command="{Binding ToggleMiningCommand}" HorizontalAlignment="Right">
          <Panel>
            <TextBlock Text="Start" IsVisible="{Binding !IsMining}" />
            <TextBlock Text="Stop" IsVisible="{Binding IsMining}" />
          </Panel>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
