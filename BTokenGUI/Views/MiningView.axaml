<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BTokenGUI.ViewModels"
             xmlns:models="using:BTokenGUI.Models"
             xmlns:views="using:BTokenGUI.Views"
             x:Class="BTokenGUI.Views.MiningView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <Style Selector="ContentControl.shelf">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="108" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="Margin" Value="18,0,0,38" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Panel Height="58" Margin="0,0,-30,-30" VerticalAlignment="Bottom" Opacity="0.35" IsHitTestVisible="False">
              <Panel.Effect>
                <BlurEffect Radius="8" />
              </Panel.Effect>
              <Path Width="30" HorizontalAlignment="Left" Data="M18,0 L30,0 L30,58 L0,28 L0,18 Z" Fill="Black" />
              <Border Margin="30,0,48,0" Background="Black" />
              <Path Width="48" HorizontalAlignment="Right" Data="M0,0 L18,0 L48,30 L48,40 L30,58 L0,58 Z" Fill="Black" />
            </Panel>
            <TemplatedControl Theme="{StaticResource ThemePlank}" />
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Margin="21,6,21,18" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ContentControl.shelf > ItemsControl">
      <Setter Property="Margin" Value="-40" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" ItemSpacing="6" Margin="40" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ContentControl.tank">
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="ContentControl.tank.besideTankAnchor">
      <Setter Property="Margin" Value="0,0,55,0" />
    </Style>
    <Style Selector="ItemsControl.heap">
      <Setter Property="Clip" Value="M42,50 A34,5 0 0 1 110,50 L80.5,100 L71.5,100 Z" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Height" Value="140" />
      <Setter Property="Margin" Value="-40,-40,-40,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="ItemContainerTheme">
        <ControlTheme TargetType="ContentPresenter">
          <Setter Property="Margin" Value="-9.5,-10.5" />
        </ControlTheme>
      </Setter>
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <views:PanelHeap Margin="40" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="Ellipse.shadowShelf">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="8" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Fill">
        <RadialGradientBrush>
          <GradientStop Offset="0" Color="#B0000000" />
          <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>
      </Setter>
    </Style>
    <Style Selector="ContentControl.shelf Ellipse.shadowShelf">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector=":is(Control).flying">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ItemsControl.flights">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <Canvas />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ItemsControl.flights :is(Control).flying">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Panel.glowing > Path.glow">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Panel.exploding">
      <Style.Animations>
        <Animation Duration="0:0:0.6" FillMode="Forward" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="ScaleTransform.ScaleX" Value="2.5" />
            <Setter Property="ScaleTransform.ScaleY" Value="2.5" />
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Panel.exploding > Path.flash">
      <Style.Animations>
        <Animation Duration="0:0:0.3" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="30%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Panel.reacting > Path.flash">
      <Style.Animations>
        <Animation Duration="0:0:0.6" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="30%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <StreamGeometry x:Key="GeometryCone">M2,10 A34,5 0 0 1 70,10 L40.5,60 L42,60 L42,67 L30,67 L30,60 L31.5,60 Z</StreamGeometry>
    <StreamGeometry x:Key="GeometryConeInterior">M2,10 A34,5 0 0 1 70,10 L40.5,60 L31.5,60 Z</StreamGeometry>
    <StreamGeometry x:Key="GeometryCap">M2,10 A34,14 0 0 1 70,10 A34,5 0 0 1 2,10 Z</StreamGeometry>
    <StreamGeometry x:Key="GeometryCapTankAnchor">M2,45 A34,14 0 0 0 70,45 A34,5 0 0 0 2,45 Z</StreamGeometry>
    <StreamGeometry x:Key="GeometryTubeCenter">M36,66 L36,76 C36,94 26,104 8,104 L4,104</StreamGeometry>
    <StreamGeometry x:Key="GeometryTubeConverter">M36,66 C36,80 57,79 57,93</StreamGeometry>
    <StreamGeometry x:Key="GeometryTankAnchor">M70,45 A34,14 0 0 1 2,45 L31.5,-5 L30,-5 L30,-12 L42,-12 L42,-5 L40.5,-5 Z</StreamGeometry>
    <StreamGeometry x:Key="GeometryTankAnchorInterior">M70,45 A34,5 0 0 1 2,45 L31.5,-5 L40.5,-5 Z</StreamGeometry>
    <StreamGeometry x:Key="GeometryPipeAnchor">M-26,93 C-26,79 -5,80 -5,65</StreamGeometry>
    <StreamGeometry x:Key="GeometryTubeAway">M36,76 C36,94 46,104 64,104 L104,104</StreamGeometry>
    <StreamGeometry x:Key="GeometrySphere">M42,70 A40,40 0 1 1 122,70 A40,40 0 1 1 42,70 Z</StreamGeometry>
    <StreamGeometry x:Key="GeometrySphereGlow">M38,70 A44,44 0 1 1 126,70 A44,44 0 1 1 38,70 Z</StreamGeometry>
    <StreamGeometry x:Key="GeometryChamber">M2,8 A34,6 0 0 1 70,8 L70,56 A34,6 0 0 1 2,56 Z</StreamGeometry>
    <StreamGeometry x:Key="GeometryLidChamber">M2,8 A34,6 0 1 1 70,8 A34,6 0 1 1 2,8 Z</StreamGeometry>
    <StreamGeometry x:Key="GeometryWallet">M8,2 L60,2 A6,6 0 0 1 66,8 L66,44 A6,6 0 0 1 60,50 L8,50 A6,6 0 0 1 2,44 L2,8 A6,6 0 0 1 8,2 Z</StreamGeometry>
    <LinearGradientBrush x:Key="BrushFadeTube" StartPoint="56,0" EndPoint="104,0">
      <GradientStop Offset="0" Color="Black" />
      <GradientStop Offset="1" Color="Transparent" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushGlass" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Offset="0" Color="#30FFFFFF" />
      <GradientStop Offset="0.35" Color="#08FFFFFF" />
      <GradientStop Offset="0.7" Color="#00000000" />
      <GradientStop Offset="1" Color="#40000000" />
    </LinearGradientBrush>
    <ControlTheme x:Key="ThemeReceptacle" TargetType="TemplatedControl">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Path Data="M1,4 L1,9 A7,2.5 0 0 0 15,9 L15,4 Z">
              <Path.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Offset="0" Color="#2A303A" />
                  <GradientStop Offset="0.3" Color="#C9D1DC" />
                  <GradientStop Offset="0.65" Color="#6B7686" />
                  <GradientStop Offset="1" Color="#1E232B" />
                </LinearGradientBrush>
              </Path.Fill>
            </Path>
            <Path Data="M1,4 A7,2.5 0 1 1 15,4 A7,2.5 0 1 1 1,4 Z">
              <Path.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Offset="0" Color="#E6ECF3" />
                  <GradientStop Offset="1" Color="#6E7888" />
                </LinearGradientBrush>
              </Path.Fill>
            </Path>
            <Path Data="M3.5,4 A4.5,1.6 0 1 1 12.5,4 A4.5,1.6 0 1 1 3.5,4 Z" Fill="#4A5260" Stroke="#1A1E25" StrokeThickness="0.5" />
            <Path Data="M5,4.2 A3,1 0 1 1 11,4.2 A3,1 0 1 1 5,4.2 Z" Fill="#05070A" />
            <Path Data="M3,3.2 A6,2 0 0 1 8,2" Stroke="White" StrokeThickness="0.6" StrokeLineCap="Round" Opacity="0.7" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="ThemeReceptacleDown" TargetType="TemplatedControl">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Path Data="M1,3 L1,8 A7,2.5 0 0 0 15,8 L15,3 Z">
              <Path.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Offset="0" Color="#2A303A" />
                  <GradientStop Offset="0.3" Color="#C9D1DC" />
                  <GradientStop Offset="0.65" Color="#6B7686" />
                  <GradientStop Offset="1" Color="#1E232B" />
                </LinearGradientBrush>
              </Path.Fill>
            </Path>
            <Path Data="M1,7 A7,2.5 0 0 0 15,7 L15,8 A7,2.5 0 0 1 1,8 Z" Fill="#9AA4B2" Opacity="0.8" />
            <Path Data="M1,3 A7,2.5 0 1 1 15,3 A7,2.5 0 1 1 1,3 Z">
              <Path.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Offset="0" Color="#E6ECF3" />
                  <GradientStop Offset="1" Color="#6E7888" />
                </LinearGradientBrush>
              </Path.Fill>
            </Path>
            <Path Data="M3,2.2 A6,2 0 0 1 8,1" Stroke="White" StrokeThickness="0.6" StrokeLineCap="Round" Opacity="0.7" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="ThemePortBlock" TargetType="TemplatedControl">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="40" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Path Data="M5,4 L20,4 L20,36 L5,36 Z">
              <Path.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Offset="0" Color="#2A303A" />
                  <GradientStop Offset="0.3" Color="#C9D1DC" />
                  <GradientStop Offset="0.65" Color="#6B7686" />
                  <GradientStop Offset="1" Color="#1E232B" />
                </LinearGradientBrush>
              </Path.Fill>
            </Path>
            <Path Data="M11,4 V36 M16,4 V36" Stroke="#1E232B" StrokeThickness="0.6" Opacity="0.6" />
            <Path Data="M1.5,0.5 L6.5,0.5 L6.5,39.5 L1.5,39.5 Z" Stroke="#1A1E25" StrokeThickness="0.5">
              <Path.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Offset="0" Color="#E6ECF3" />
                  <GradientStop Offset="1" Color="#6E7888" />
                </LinearGradientBrush>
              </Path.Fill>
            </Path>
            <Path Data="M2.5,3 L5.5,3 L5.5,37 L2.5,37 Z" Fill="#05070A" Stroke="#1A1E25" StrokeThickness="0.5" />
            <Path Classes="shutter" Data="M2.5,3 L5.5,3 L5.5,37 L2.5,37 Z" Fill="#4A5260" Stroke="#1A1E25" StrokeThickness="0.5" />
            <Path Classes="shutter" Data="M2.5,9 H5.5 M2.5,15 H5.5 M2.5,21 H5.5 M2.5,27 H5.5 M2.5,33 H5.5" Stroke="#1A1E25" StrokeThickness="0.5" />
            <Path Data="M2,1.5 V12" Stroke="White" StrokeThickness="0.6" StrokeLineCap="Round" Opacity="0.7" />
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^.open /template/ Path.shutter">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="ThemePlug" TargetType="TemplatedControl">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="11" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Path Data="M0.5,0.5 L9.5,0.5 L9.5,10.5 L0.5,10.5 Z" Stroke="#1E232B" StrokeThickness="0.6">
              <Path.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Offset="0" Color="#2A303A" />
                  <GradientStop Offset="0.3" Color="#C9D1DC" />
                  <GradientStop Offset="0.65" Color="#6B7686" />
                  <GradientStop Offset="1" Color="#1E232B" />
                </LinearGradientBrush>
              </Path.Fill>
            </Path>
            <Path Data="M1,2.5 H9 M1,4.5 H9 M1,6.5 H9" Stroke="#2A303A" StrokeThickness="0.8" Opacity="0.8" />
            <Path Data="M0.5,8.5 L9.5,8.5 L9.5,10.5 L0.5,10.5 Z" Fill="#3A4250" Stroke="#1E232B" StrokeThickness="0.6" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="ThemeCube" TargetType="ContentControl">
      <Setter Property="Width" Value="72" />
      <Setter Property="Height" Value="98" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Width="52" Height="78" Margin="19,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource BrushWindowBackground}" IsHitTestVisible="False">
              <Border Background="{TemplateBinding BorderBrush}" Opacity="0.36" />
            </Border>
            <Panel IsHitTestVisible="False">
              <Path Data="M1,19 L19,1 L19,79 L1,97 Z M1,97 L19,79 L71,79 L53,97 Z" Fill="{StaticResource BrushWindowBackground}" />
              <Path Data="M1,19 L19,1 L19,79 L1,97 Z" Fill="{TemplateBinding BorderBrush}" Opacity="0.2" />
              <Path Data="M1,97 L19,79 L71,79 L53,97 Z" Fill="{TemplateBinding BorderBrush}" Opacity="0.5" />
              <Path Data="M19,1 L19,79 L71,79 M19,79 L1,97" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" Opacity="0.5" />
            </Panel>
            <TemplatedControl Classes="portBottom" Theme="{StaticResource ThemeReceptacle}" Margin="28,78,0,0" />
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
            <Panel IsHitTestVisible="False">
              <Path Data="M1,19 L19,1 L71,1 L53,19 Z" Fill="{StaticResource BrushWindowBackground}" />
              <Path Data="M1,19 L19,1 L71,1 L53,19 Z" Fill="{TemplateBinding BorderBrush}" Opacity="0.68" />
              <Path Data="M1,19 L53,19 L53,97 L1,97 Z" Fill="{TemplateBinding BorderBrush}" Opacity="0.36" />
              <Path Data="M53,19 L71,1 L71,79 L53,97 Z" Fill="{StaticResource BrushWindowBackground}" />
              <Path Data="M53,19 L71,1 L71,79 L53,97 Z" Fill="{TemplateBinding BorderBrush}" Opacity="0.2" />
              <Path Data="M1,19 L19,1 L71,1 L71,79 L53,97 L1,97 Z M1,19 L53,19 L71,1 M53,19 L53,97" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" StrokeJoin="Round" />
            </Panel>
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="ThemeChip" TargetType="ContentControl">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Ellipse Width="25.2" Height="25.2" Fill="{TemplateBinding BorderBrush}" Opacity="0.9">
              <Ellipse.Effect>
                <BlurEffect Radius="6" />
              </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="18" Height="18" Fill="{TemplateBinding Background}" Stroke="White" StrokeThickness="0.75" />
            <Ellipse Width="16.65" Height="16.65" Stroke="White" StrokeThickness="1.35" StrokeDashArray="2,2.67" Opacity="0.85" />
            <Ellipse Width="14.7" Height="14.7" Stroke="White" StrokeThickness="0.6" Opacity="0.7" />
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="ThemeCone" TargetType="ContentControl">
      <Setter Property="Width" Value="72" />
      <Setter Property="Height" Value="112" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Path Data="{StaticResource GeometryCone}" Margin="10,10,-10,-10" Fill="Black" Opacity="0.35" IsHitTestVisible="False">
              <Path.Effect>
                <BlurEffect Radius="8" />
              </Path.Effect>
            </Path>
            <Panel IsHitTestVisible="False">
              <Path Data="{StaticResource GeometryConeInterior}" Fill="{StaticResource BrushWindowBackground}" Opacity="0.6" />
              <Path Data="{StaticResource GeometryConeInterior}" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0.12" />
              <Path Data="M2,10 A34,5 0 0 1 70,10" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" Opacity="0.6" />
            </Panel>
            <ContentPresenter Content="{TemplateBinding Content}" ClipToBounds="False" />
            <Panel IsHitTestVisible="False">
              <Path Data="{StaticResource GeometryCap}" Fill="{DynamicResource SystemControlHighlightAccentBrush}" />
              <Path Data="{StaticResource GeometryCap}" Fill="{StaticResource BrushGlass}" />
              <Path Data="M11,1 A26,9 0 0 1 30,-3" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" Opacity="0.25" />
              <Path Data="M2,10 A34,14 0 0 1 70,10" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" StrokeLineCap="Round" />
              <TemplatedControl Classes="portLid" Theme="{StaticResource ThemeReceptacle}" Margin="28,-14,0,0" />
            </Panel>
            <Panel IsHitTestVisible="False">
              <Path Data="M2,10 A34,5 0 0 0 70,10 L40.5,60 L31.5,60 Z" Fill="{StaticResource BrushGlass}" />
              <Path Data="M8,16 L30,53" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" Opacity="0.25" />
              <Path Data="M12,27 A24,3.5 0 0 0 60,27 M25,49 A11,1.6 0 0 0 47,49" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="1.5" Opacity="0.7" />
              <Path Data="M66.5,16 H70.5 M60,27 H64 M53.5,38 H57.5 M47,49 H51" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="1" />
              <Path Data="M2,10 L31.5,60 M70,10 L40.5,60" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" StrokeLineCap="Round" />
              <Path Data="M2,10 A34,5 0 0 0 70,10" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="3" StrokeLineCap="Round" />
              <Path Data="M64.4,12.5 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0 M52,14.3 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0 M35,15 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0 M18,14.3 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0 M5.6,12.5 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0" Fill="White" Opacity="0.7" />
              <TemplatedControl Classes="portNozzle" Theme="{StaticResource ThemeReceptacleDown}" Margin="28,57,0,0" />
            </Panel>
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="ThemeTankAnchor" TargetType="ContentControl">
      <Setter Property="Width" Value="72" />
      <Setter Property="Height" Value="60" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Path Data="{StaticResource GeometryTankAnchor}" Margin="10,10,-10,-10" Fill="Black" Opacity="0.35" IsHitTestVisible="False">
              <Path.Effect>
                <BlurEffect Radius="8" />
              </Path.Effect>
            </Path>
            <Panel IsHitTestVisible="False">
              <TemplatedControl Theme="{StaticResource ThemeReceptacleDown}" Margin="28,57,0,0" />
              <Path Data="{StaticResource GeometryCapTankAnchor}" Fill="{DynamicResource SystemControlHighlightAccentBrush}" />
              <Path Data="{StaticResource GeometryCapTankAnchor}" Fill="{StaticResource BrushGlass}" />
              <Path Data="M2,45 A34,14 0 0 0 70,45" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" StrokeLineCap="Round" />
              <Path Data="{StaticResource GeometryTankAnchorInterior}" Fill="{StaticResource BrushWindowBackground}" Opacity="0.6" />
              <Path Data="{StaticResource GeometryTankAnchorInterior}" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0.12" />
              <Path Data="M2,45 A34,5 0 0 1 70,45" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" Opacity="0.6" />
            </Panel>
            <ContentPresenter Content="{TemplateBinding Content}" ClipToBounds="False" RenderTransformOrigin="36,27.5" RenderTransform="rotate(180deg)" />
            <Panel IsHitTestVisible="False">
              <Path Data="M2,45 A34,5 0 0 0 70,45 L40.5,-5 L31.5,-5 Z" Fill="{StaticResource BrushGlass}" />
              <Path Data="M8,39 L30,2" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" Opacity="0.25" />
              <Path Data="M12,28 A24,3.5 0 0 0 60,28 M25,6 A11,1.6 0 0 0 47,6" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="1.5" Opacity="0.7" />
              <Path Data="M66.5,39 H70.5 M60,28 H64 M53.5,17 H57.5 M47,6 H51" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="1" />
              <Path Data="M2,45 L31.5,-5 M70,45 L40.5,-5" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" StrokeLineCap="Round" />
              <Path Data="M2,45 A34,5 0 0 0 70,45" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="3" StrokeLineCap="Round" />
              <Path Data="M64.4,47.5 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0 M52,49.3 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0 M35,50 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0 M18,49.3 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0 M5.6,47.5 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0" Fill="White" Opacity="0.7" />
              <TemplatedControl Classes="portNozzle" Theme="{StaticResource ThemeReceptacle}" Margin="28,-14,0,0" />
            </Panel>
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="ThemePlank" TargetType="TemplatedControl">
      <Setter Property="Height" Value="28" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Background" Value="{StaticResource BrushWindowBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Height="18" Margin="1,1,19,0" VerticalAlignment="Top" Background="{TemplateBinding Background}" RenderTransformOrigin="0%,100%">
              <Border.RenderTransform>
                <SkewTransform AngleX="-45" />
              </Border.RenderTransform>
              <Panel>
                <Border Background="{TemplateBinding BorderBrush}" Opacity="0.68" />
                <Border>
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Offset="0" Color="#48000000" />
                      <GradientStop Offset="1" Color="#18FFFFFF" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
              </Panel>
            </Border>
            <Panel Width="20" HorizontalAlignment="Right" Clip="M1,19 L19,1 L19,9 L1,27 Z">
              <Border Background="{TemplateBinding Background}" />
              <Border Background="{TemplateBinding BorderBrush}" Opacity="0.2" />
            </Panel>
            <Border Height="10" Margin="0,18,18,0" VerticalAlignment="Top" CornerRadius="1" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
              <Panel>
                <Border Background="{TemplateBinding BorderBrush}" Opacity="0.36" />
                <Border>
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Offset="0" Color="#18FFFFFF" />
                      <GradientStop Offset="1" Color="#48000000" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
              </Panel>
            </Border>
            <Border Height="2" Margin="18,0,0,0" VerticalAlignment="Top" CornerRadius="1" Background="{TemplateBinding BorderBrush}" />
            <Path Width="20" HorizontalAlignment="Left" Data="M1,19 L19,1" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" StrokeLineCap="Round" />
            <Path Width="20" HorizontalAlignment="Right" Data="M1,19 L19,1 L19,9 L1,27" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="ThemeRail" TargetType="TemplatedControl">
      <Setter Property="Height" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="BorderThickness" Value="0,1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Background="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0.4">
              <Border.OpacityMask>
                <DrawingBrush TileMode="Tile" DestinationRect="0,0,40,10">
                  <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="Black" Geometry="F0 M0,0 H40 V10 H0 Z M16,3 H24 A2,2 0 0 1 24,7 H16 A2,2 0 0 1 16,3 Z" />
                  </DrawingBrush.Drawing>
                </DrawingBrush>
              </Border.OpacityMask>
            </Border>
            <Border BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <DataTemplate x:Key="TemplateBlockDetails" x:DataType="models:Blockchain+Block">
      <StackPanel Spacing="12">
        <ItemsControl ItemsSource="{Binding Fields}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Blockchain+Block+Field">
              <Grid ColumnDefinitions="140,*" Margin="0,2">
                <SelectableTextBlock Grid.Column="0" Text="{Binding Name}" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <SelectableTextBlock Text="TXs" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding TXs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Blockchain+TX">
              <Border Classes="Panel" Margin="0,0,0,6">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateTX}" Margin="8" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateAnchor" x:DataType="models:Blockchain+Anchor">
      <Panel Width="72" Height="72" Margin="-20" Classes.glowing="{Binding ReasonForNotGlowing, Converter={x:Static ObjectConverters.IsNull}}" Classes.flying="{Binding IsFlying}">
        <Path Classes="glow" Data="M30,30 L42,30 L42,42 L30,42 Z" Fill="{Binding BrushPair}" Stroke="{Binding BrushPair}" StrokeThickness="5" StrokeJoin="Round" Opacity="0" IsHitTestVisible="False">
          <Path.Effect>
            <BlurEffect Radius="8" />
          </Path.Effect>
        </Path>
        <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button.Flyout>
            <Flyout>
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateFlyoutAnchor}" />
            </Flyout>
          </Button.Flyout>
          <ContentControl Theme="{StaticResource ThemeChip}" BorderBrush="{Binding BrushPair}" Background="{Binding BrushPair}">
            <Path Width="5.4" Height="6.75" Stretch="Uniform" Data="M0.37,1.63 L1.63,0.37 L5.27,0.37 L5.27,5.83 L4.01,7.09 L0.37,7.09 Z M0.37,1.63 L4.01,1.63 L5.27,0.37 M4.01,1.63 L4.01,7.09" Stroke="#FFF6DC" StrokeThickness="0.9" StrokeJoin="Round" />
          </ContentControl>
        </Button>
      </Panel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateBlockMined" x:DataType="models:Blockchain+Block">
      <Panel Width="28" Height="32" Margin="2,0" Classes.flying="{Binding IsFlying}" Classes.exploding="{Binding IsExploding}" RenderTransformOrigin="50%,50%">
        <Panel.RenderTransform>
          <ScaleTransform />
        </Panel.RenderTransform>
        <Ellipse Classes="shadowShelf" Margin="0,0,4,-3" />
        <Path Classes="flash" Width="23" Height="30" Data="M0.5,6.5 L6.5,0.5 L22.5,0.5 L22.5,23.5 L16.5,29.5 L0.5,29.5 Z" Fill="White" Opacity="0" IsHitTestVisible="False">
          <Path.Effect>
            <BlurEffect Radius="8" />
          </Path.Effect>
        </Path>
        <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button.Flyout>
            <Flyout Opening="LoadTXsFlyout">
              <ScrollViewer MaxHeight="600">
                <StackPanel Spacing="12" MaxWidth="420">
                  <SelectableTextBlock Text="Mined block" FontWeight="Bold" />
                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateBlockDetails}" />
                </StackPanel>
              </ScrollViewer>
            </Flyout>
          </Button.Flyout>
          <Panel Width="23" Height="30">
            <Path Data="M6.5,0.5 L22.5,0.5 L22.5,23.5 L6.5,23.5 Z" Fill="{StaticResource BrushWindowBackground}" />
            <Path Data="M6.5,0.5 L22.5,0.5 L22.5,23.5 L6.5,23.5 Z" Fill="{Binding BrushPair}" Opacity="0.36" />
            <Path Data="M0.5,6.5 L6.5,0.5 L22.5,0.5 L16.5,6.5 Z" Fill="{Binding BrushPair}" Opacity="0.68" />
            <Path Data="M0.5,6.5 L16.5,6.5 L16.5,29.5 L0.5,29.5 Z" Fill="{Binding BrushPair}" Opacity="0.36" />
            <Path Data="M16.5,6.5 L22.5,0.5 L22.5,23.5 L16.5,29.5 Z" Fill="{Binding BrushPair}" Opacity="0.2" />
            <Path Data="M0.5,6.5 L6.5,0.5 L22.5,0.5 L22.5,23.5 L16.5,29.5 L0.5,29.5 Z M0.5,6.5 L16.5,6.5 L22.5,0.5 M16.5,6.5 L16.5,29.5" Stroke="{Binding BrushPair}" StrokeThickness="1" StrokeJoin="Round" />
          </Panel>
        </Button>
      </Panel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateChip" x:DataType="models:Blockchain+Chip">
      <Panel Width="32" Height="32" Classes.flying="{Binding IsFlying}" Classes.exploding="{Binding IsExploding}" RenderTransformOrigin="50%,50%">
        <Panel.RenderTransform>
          <ScaleTransform />
        </Panel.RenderTransform>
        <Button Command="{Binding LoadTXCommand}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button.Flyout>
            <Flyout>
              <StackPanel Spacing="12" MaxWidth="420">
                <SelectableTextBlock Text="Output TX" FontWeight="Bold" />
                <ContentControl Content="{Binding TX}" ContentTemplate="{StaticResource TemplateTX}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <ContentControl Theme="{StaticResource ThemeChip}" BorderBrush="#FF8A1F">
            <ContentControl.Background>
              <RadialGradientBrush>
                <GradientStop Offset="0" Color="#FFD27A" />
                <GradientStop Offset="1" Color="#FF6A00" />
              </RadialGradientBrush>
            </ContentControl.Background>
            <Path Width="6.5" Height="8" Stretch="Uniform" Data="M3,2 V10 M3,2 H6 A2,2 0 0 1 6,6 H3 M6,6 A2.2,2 0 0 1 6,10 H2 M2,2 H3 M4,0.8 V2 M6,0.8 V2 M4,10 V11.2 M6,10 V11.2" Stroke="#FFF6DC" StrokeThickness="0.9" StrokeLineCap="Round" StrokeJoin="Round" />
          </ContentControl>
        </Button>
        <Path Classes="flash" Data="M10,10 L22,10 L22,22 L10,22 Z" Fill="White" Opacity="0">
          <Path.Effect>
            <BlurEffect Radius="6" />
          </Path.Effect>
        </Path>
      </Panel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateChipTX" x:DataType="models:Blockchain+Chip">
      <Panel Width="32" Height="32">
        <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button.Flyout>
            <Flyout>
              <StackPanel Spacing="12" MaxWidth="420">
                <SelectableTextBlock Text="Pool TX" FontWeight="Bold" />
                <ContentControl Content="{Binding TX}" ContentTemplate="{StaticResource TemplateTX}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <ContentControl Theme="{StaticResource ThemeChip}" BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" Background="{DynamicResource SystemControlHighlightAccentBrush}">
            <Path Width="7" Height="7" Stretch="Uniform" Data="M1,2.5 H8 M6,0.5 L8,2.5 L6,4.5 M8,7.5 H1 M3,5.5 L1,7.5 L3,9.5" Stroke="#FFF6DC" StrokeThickness="0.9" StrokeLineCap="Round" StrokeJoin="Round" />
          </ContentControl>
        </Button>
      </Panel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateBlockchain" x:DataType="models:Blockchain">
      <DockPanel Margin="10">
        <Grid RowDefinitions="Auto,Auto,Auto" Margin="0,0,40,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnBlocks" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Panel Classes="shelves" Grid.Column="1" Width="800" Margin="-400,0,-343,0" HorizontalAlignment="Right">
            <ContentControl Classes="shelf" IsVisible="{Binding IsBlocksMinedPoolVisible}">
              <ItemsControl ItemsSource="{Binding BlocksMined}" ItemTemplate="{StaticResource TemplateBlockMined}" />
            </ContentControl>
          </Panel>
          <Panel Grid.Row="1" Grid.Column="0" ClipToBounds="True">
            <Panel Width="160" Margin="-160,0,0,58" HorizontalAlignment="Right" IsHitTestVisible="False">
              <Panel.OpacityMask>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Offset="0" Color="Transparent" />
                  <GradientStop Offset="1" Color="Black" />
                </LinearGradientBrush>
              </Panel.OpacityMask>
              <TemplatedControl Theme="{StaticResource ThemeRail}" />
              <ContentControl Theme="{StaticResource ThemeCube}" BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0.5" Margin="52,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Panel>
          </Panel>
          <Panel Grid.Row="1" Grid.Column="1">
            <TemplatedControl Theme="{StaticResource ThemeRail}" BorderThickness="0,1,1,1" Margin="0,0,0,58" />
            <ItemsControl Classes="blocks" ItemsSource="{Binding Blocks}" Margin="0,-36,-28,0" ContainerPrepared="ExtendTip" ContainerClearing="PresentBlockLeaving">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="36" Margin="0,36,40,58" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Blockchain+Block">
                  <Panel Width="72" Height="98" Classes.flying="{Binding IsFlying}">
                    <Path Data="M1,19 L19,1 L71,1 L101,31 L101,109 L83,127 L31,127 L1,97 Z" Fill="Black" Opacity="0.35" IsHitTestVisible="False">
                      <Path.Effect>
                        <BlurEffect Radius="8" />
                      </Path.Effect>
                    </Path>
                    <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                      <Button.Flyout>
                        <Flyout Opening="LoadTXsFlyout">
                          <ScrollViewer MaxHeight="600">
                            <StackPanel Spacing="12" MaxWidth="420">
                              <SelectableTextBlock Text="Block" FontWeight="Bold" />
                              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateBlockDetails}" />
                            </StackPanel>
                          </ScrollViewer>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <ContentControl Theme="{StaticResource ThemeCube}" BorderBrush="{Binding BrushPair, TargetNullValue={StaticResource SystemControlHighlightAccentBrush}}">
                      <ItemsControl ItemsSource="{Binding Anchors}" ItemTemplate="{StaticResource TemplateAnchor}" Width="52" Height="78" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <ItemsControl.ItemContainerTheme>
                          <ControlTheme TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,-8" />
                          </ControlTheme>
                        </ItemsControl.ItemContainerTheme>
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </ContentControl>
                    <TextBlock Text="{Binding Height}" Width="52" Margin="1,22,0,0" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12" FontWeight="Bold" Foreground="White" IsHitTestVisible="False">
                      <TextBlock.Effect>
                        <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="3" Color="Black" Opacity="1" />
                      </TextBlock.Effect>
                    </TextBlock>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
          <Panel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,76,0" ClipToBounds="True" IsHitTestVisible="False" IsVisible="{Binding !Tank.IsFeedingConverter}">
            <Canvas>
              <Grid Width="{Binding $parent[DockPanel].Bounds.Width}" ColumnDefinitions="*,*">
                <Panel Grid.Column="1" Height="8" Margin="12,100,0,0" VerticalAlignment="Top" Classes.glowing="{Binding Tank.IsAutoActive}">
                  <Border Background="{DynamicResource SystemControlHighlightAccentBrush}" />
                  <Border Height="5" Background="{StaticResource BrushWindowBackground}" />
                  <Border Height="5" Background="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0.36" />
                  <Path Classes="glow" Data="M0,0 H1 V1 H0 Z" Stretch="Fill" Height="6" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0" IsVisible="{Binding Tank.IsAutoToWalletGUI}">
                    <Path.Effect>
                      <BlurEffect Radius="6" />
                    </Path.Effect>
                  </Path>
                </Panel>
              </Grid>
            </Canvas>
          </Panel>
          <Panel Grid.Row="2" Grid.ColumnSpan="3" Width="68" Height="52" Margin="0,78,-40,0" HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding !Tank.IsFeedingConverter}">
            <Path Data="{StaticResource GeometryWallet}" Margin="10,10,-10,-10" Fill="Black" Opacity="0.35" IsHitTestVisible="False">
              <Path.Effect>
                <BlurEffect Radius="8" />
              </Path.Effect>
            </Path>
            <Button Command="{Binding $parent[views:MiningView].((vm:MainViewModel)DataContext).Wallet.ActivateViewCommand}" Width="64" Height="48" Margin="2,2,0,0" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Panel IsHitTestVisible="False">
              <Path Data="{StaticResource GeometryWallet}" Fill="{StaticResource BrushWindowBackground}" />
              <Path Data="{StaticResource GeometryWallet}" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0.36" />
              <Path Data="{StaticResource GeometryWallet}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" StrokeJoin="Round" />
              <Path Data="M66,14 L46,14 A6,6 0 0 0 40,20 L40,32 A6,6 0 0 0 46,38 L66,38" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" StrokeJoin="Round" />
              <Path Data="M47,26 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0" Fill="White" Opacity="0.8" />
            </Panel>
          </Panel>
          <ContentControl Classes="tank" Classes.besideTankAnchor="{Binding IsTankAnchorVisible}" Grid.Row="2" Grid.Column="1" Theme="{StaticResource ThemeCone}" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Panel Classes.glowing="{Binding Tank.IsAutoActive}">
              <Panel IsHitTestVisible="False" IsVisible="{Binding !Tank.IsFeedingConverter}">
                <Path Data="{StaticResource GeometryTubeCenter}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="8" />
                <Path Data="{StaticResource GeometryTubeAway}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="8" OpacityMask="{StaticResource BrushFadeTube}" />
                <Path Data="{StaticResource GeometryTubeCenter}" Stroke="{StaticResource BrushWindowBackground}" StrokeThickness="5" />
                <Path Data="{StaticResource GeometryTubeAway}" Stroke="{StaticResource BrushWindowBackground}" StrokeThickness="5" OpacityMask="{StaticResource BrushFadeTube}" />
                <Path Data="{StaticResource GeometryTubeCenter}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="5" Opacity="0.36" />
                <Path Data="{StaticResource GeometryTubeAway}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="5" Opacity="0.36" OpacityMask="{StaticResource BrushFadeTube}" />
              </Panel>
              <Panel IsHitTestVisible="False" IsVisible="{Binding Tank.IsFeedingConverter}">
                <Path Classes="tubeConverter" Data="{StaticResource GeometryTubeConverter}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="8" />
                <Path Data="{StaticResource GeometryTubeConverter}" Stroke="{StaticResource BrushWindowBackground}" StrokeThickness="5" />
                <Path Data="{StaticResource GeometryTubeConverter}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="5" Opacity="0.36" />
              </Panel>
              <Path Classes="glow" Data="{StaticResource GeometryTubeCenter}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="6" Opacity="0" IsVisible="{Binding Tank.IsAutoToWalletGUI}" IsHitTestVisible="False">
                <Path.Effect>
                  <BlurEffect Radius="6" />
                </Path.Effect>
              </Path>
              <Path Classes="glow" Data="{StaticResource GeometryTubeAway}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="6" Opacity="0" OpacityMask="{StaticResource BrushFadeTube}" IsVisible="{Binding !Tank.IsAutoToWalletGUI}" IsHitTestVisible="False">
                <Path.Effect>
                  <BlurEffect Radius="6" />
                </Path.Effect>
              </Path>
              <Button Command="{Binding Tank.OpenPanelCommand}" Height="68" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
              <Path Data="{StaticResource GeometryConeInterior}" Fill="#FF8A1F" Opacity="0.9" RenderTransformOrigin="36,60" IsVisible="{Binding !Tank.IsFeedingConverter}" IsHitTestVisible="False">
                <Path.RenderTransform>
                  <ScaleTransform ScaleX="{Binding FillingPowder}" ScaleY="{Binding FillingPowder}" />
                </Path.RenderTransform>
              </Path>
              <Path Classes="glow" Data="{StaticResource GeometryCone}" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="4" StrokeJoin="Round" Opacity="0" IsHitTestVisible="False">
                <Path.Effect>
                  <BlurEffect Radius="10" />
                </Path.Effect>
              </Path>
              <ItemsControl Classes="heap" ItemsSource="{Binding Tank.Chips}" ItemTemplate="{StaticResource TemplateChip}" />
            </Panel>
          </ContentControl>
          <ContentControl Classes="tankAnchor" Grid.Row="2" Grid.Column="1" Theme="{StaticResource ThemeTankAnchor}" Margin="0,0,-31,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding IsTankAnchorVisible}">
            <Panel>
              <Button Command="{Binding OpenFormAnchorsCommand}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
              <ItemsControl Classes="heap" ItemsSource="{Binding Anchors}" ItemTemplate="{StaticResource TemplateAnchor}" />
            </Panel>
          </ContentControl>
          <Canvas Grid.Row="2" Grid.Column="1" Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" IsVisible="{Binding IsTankAnchorVisible}">
            <Path Classes="pipeAnchor" Data="{StaticResource GeometryPipeAnchor}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="8" StrokeJoin="Round" />
            <Path Data="{StaticResource GeometryPipeAnchor}" Stroke="{StaticResource BrushWindowBackground}" StrokeThickness="5" StrokeJoin="Round" />
            <Path Data="{StaticResource GeometryPipeAnchor}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="5" StrokeJoin="Round" Opacity="0.36" />
          </Canvas>
        </Grid>
      </DockPanel>
    </DataTemplate>
  </UserControl.Resources>
  <Border Classes="Panel">
    <Border.Background>
      <RadialGradientBrush Center="0%,0%" GradientOrigin="0%,0%" RadiusX="100%" RadiusY="100%">
        <GradientStop Offset="0" Color="#60FFFFFF" />
        <GradientStop Offset="1" Color="#06FFFFFF" />
      </RadialGradientBrush>
    </Border.Background>
    <DockPanel Margin="20">
      <SelectableTextBlock DockPanel.Dock="Top" Text="Mining" FontWeight="Bold" Margin="0,0,0,10" />
      <ScrollViewer VerticalScrollBarVisibility="Hidden" IsVisible="{Binding BlockchainBToken.IsPlaced}">
        <Panel>
          <Panel.DataTemplates>
            <DataTemplate DataType="models:Blockchain+Anchor">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateAnchor}" />
            </DataTemplate>
            <DataTemplate DataType="models:Blockchain+Block">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateBlockMined}" />
            </DataTemplate>
            <DataTemplate DataType="models:Blockchain+Chip">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateChip}" />
            </DataTemplate>
          </Panel.DataTemplates>
          <Canvas x:Name="CanvasPipes" IsHitTestVisible="False" />
          <StackPanel Grid.IsSharedSizeScope="True">
            <ContentControl x:Name="ContentBlockchainBitcoin" Content="{Binding BlockchainBitcoin}" ContentTemplate="{StaticResource TemplateBlockchain}" />
            <StackPanel DataContext="{Binding Mining}" x:DataType="models:Mining" Spacing="10" Margin="10">
              <Grid Margin="0,-66,40,-10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3*" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnBlocks" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Panel Grid.Column="1" Width="48" Height="34" Margin="0,53,102,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
                  <Path Data="M0,1 H48 V33 H0 Z" Fill="{StaticResource BrushWindowBackground}" Opacity="0.6" />
                  <Path Data="M0,1 H48 V33 H0 Z" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0.12" />
                  <Path Data="M0,5 H48" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="1" Opacity="0.4" />
                  <Path Data="M0,1 H48 V33 H0 Z" Fill="{StaticResource BrushGlass}" />
                  <Path Data="M0,1 H48 M0,33 H48" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" />
                </Panel>
                <Panel Grid.Column="1" Width="72" Height="70" Margin="0,39,164,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
                  <Path Data="{StaticResource GeometryChamber}" Margin="10,10,-10,-10" Fill="Black" Opacity="0.35">
                    <Path.Effect>
                      <BlurEffect Radius="8" />
                    </Path.Effect>
                  </Path>
                  <TemplatedControl Theme="{StaticResource ThemePortBlock}" Margin="66,11,0,0" RenderTransform="rotate(180deg)" />
                  <Path Data="{StaticResource GeometryChamber}" Fill="{StaticResource BrushWindowBackground}" Opacity="0.6" />
                  <Path Data="{StaticResource GeometryChamber}" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0.12" />
                  <Path Data="M2,56 A34,6 0 0 1 70,56" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" Opacity="0.6" />
                  <Path Data="{StaticResource GeometryChamber}" Fill="{StaticResource BrushGlass}" />
                  <Path Data="M2,8 L2,56 M70,8 L70,56" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" />
                  <Path Data="M2,56 A34,6 0 0 0 70,56" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" StrokeLineCap="Round" />
                  <Path Data="{StaticResource GeometryLidChamber}" Fill="{DynamicResource SystemControlHighlightAccentBrush}" />
                  <Path Data="{StaticResource GeometryLidChamber}" Fill="{StaticResource BrushGlass}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" />
                  <Path Data="M10,16 L10,50" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" Opacity="0.25" />
                </Panel>
                <ContentControl Classes="tankPool" Grid.Column="1" Theme="{StaticResource ThemeCone}" Margin="0,-22,164,0" HorizontalAlignment="Right" VerticalAlignment="Top" DataContext="{Binding $parent[views:MiningView].((vm:MainViewModel)DataContext).BlockchainBToken}" x:DataType="models:Blockchain">
                  <ItemsControl Classes="heap" ItemsSource="{Binding TXsPool}" ItemTemplate="{StaticResource TemplateChipTX}" />
                </ContentControl>
                <Panel x:Name="PanelConverter" Grid.Column="1" Width="164" Height="140" Margin="0,0,-34,0" HorizontalAlignment="Right" Classes.glowing="{Binding IsMining}">
                  <Path Classes="glow" Data="{StaticResource GeometrySphereGlow}" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0" IsHitTestVisible="False">
                    <Path.Effect>
                      <BlurEffect Radius="16" />
                    </Path.Effect>
                  </Path>
                  <Path Data="{StaticResource GeometrySphere}" Margin="10,10,-10,-10" Fill="Black" Opacity="0.35" IsHitTestVisible="False">
                    <Path.Effect>
                      <BlurEffect Radius="8" />
                    </Path.Effect>
                  </Path>
                  <TemplatedControl Theme="{StaticResource ThemePortBlock}" Margin="28,50,0,0" />
                  <TemplatedControl x:Name="PortHatch" Theme="{StaticResource ThemePortBlock}" Margin="72,94,0,0" RenderTransform="rotate(-90deg)" />
                  <Panel IsHitTestVisible="False">
                    <Path Data="{StaticResource GeometrySphere}" Fill="{StaticResource BrushWindowBackground}" Opacity="0.6" />
                    <Path Data="{StaticResource GeometrySphere}" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0.12" />
                    <Path Data="M42,70 A40,6 0 0 1 122,70" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" Opacity="0.6" />
                  </Panel>
                  <Button Command="{Binding OpenFormConverterCommand}" Width="80" Height="80" Margin="42,30,0,0" Padding="0" CornerRadius="40" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <Panel IsHitTestVisible="False">
                    <Path Data="{StaticResource GeometrySphere}" Fill="{StaticResource BrushGlass}" />
                    <Path Data="M42,70 A40,6 0 0 0 122,70" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" StrokeLineCap="Round" />
                    <Path Data="{StaticResource GeometrySphere}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="2" />
                    <Path Data="M54.3,54 A32,32 0 0 1 71.1,39.9" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" Opacity="0.25" />
                    <Path Data="M58,47 a3,2 0 1 0 6,0 a3,2 0 1 0 -6,0" Fill="White" Opacity="0.5" />
                    <Path Data="M90,85 A9,9 0 1 1 108,85 A9,9 0 1 1 90,85 Z" Stroke="#1A1E25" StrokeThickness="0.5">
                      <Path.Fill>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                          <GradientStop Offset="0" Color="#E6ECF3" />
                          <GradientStop Offset="1" Color="#6E7888" />
                        </LinearGradientBrush>
                      </Path.Fill>
                    </Path>
                    <Path Data="M91.5,85 A7.5,7.5 0 1 1 106.5,85 A7.5,7.5 0 1 1 91.5,85 Z" Fill="#05070A" />
                    <Path Data="M93.8,88 A6,6 0 1 1 104.2,88" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="1.2" StrokeLineCap="Round" />
                    <Path Data="M99,85 L99,79.5" Stroke="White" StrokeThickness="1" StrokeLineCap="Round" RenderTransformOrigin="99,85">
                      <Path.RenderTransform>
                        <RotateTransform Angle="{Binding AngleGaugeConverter}" />
                      </Path.RenderTransform>
                    </Path>
                    <Path Data="M97.8,85 a1.2,1.2 0 1 0 2.4,0 a1.2,1.2 0 1 0 -2.4,0" Fill="White" />
                    <Path Data="M92.5,82 A7,7 0 0 1 97,78.3" Stroke="White" StrokeThickness="0.6" StrokeLineCap="Round" Opacity="0.5" />
                    <TemplatedControl Theme="{StaticResource ThemeReceptacle}" Margin="52,30,0,0" />
                    <TemplatedControl Theme="{StaticResource ThemeReceptacle}" Margin="96,30,0,0" />
                    <TemplatedControl Theme="{StaticResource ThemePlug}" Margin="55,24.6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <TemplatedControl Theme="{StaticResource ThemePlug}" Margin="99,24.6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                  </Panel>
                  <Path Classes="flash" Data="M52,70 A30,30 0 1 1 112,70 A30,30 0 1 1 52,70 Z" Fill="White" Opacity="0" IsHitTestVisible="False">
                    <Path.Effect>
                      <BlurEffect Radius="12" />
                    </Path.Effect>
                  </Path>
                </Panel>
              </Grid>
              <SelectableTextBlock Text="{Binding StateMiner}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
            </StackPanel>
            <ContentControl x:Name="ContentBlockchainBToken" Content="{Binding BlockchainBToken}" ContentTemplate="{StaticResource TemplateBlockchain}" />
          </StackPanel>
          <Canvas x:Name="CanvasPlugs" IsHitTestVisible="False" />
          <ItemsControl x:Name="ItemsFlights" Classes="flights" DataContext="{Binding BlockchainBitcoin}" ItemsSource="{Binding Flights}" x:DataType="models:Blockchain" />
          <ItemsControl x:Name="ItemsFlightsBToken" Classes="flights" DataContext="{Binding BlockchainBToken}" ItemsSource="{Binding Flights}" x:DataType="models:Blockchain" />
        </Panel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
