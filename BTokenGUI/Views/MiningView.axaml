    <ControlTheme x:Key="ThemeRail" TargetType="TemplatedControl">
      <Setter Property="Height" Value="40" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Height="10" VerticalAlignment="Top" RenderTransformOrigin="0,0" RenderTransform="scale(1,4)">
            <Border Height="5.6" Margin="0,1.4,0,0" VerticalAlignment="Top">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Offset="0" Color="#181C22" />
                  <GradientStop Offset="0.3" Color="#2A3038" />
                  <GradientStop Offset="1" Color="#414852" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Border Height="5.6" Margin="0,1.4,0,0" VerticalAlignment="Top">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Offset="0" Color="#00FFFFFF" />
                  <GradientStop Offset="1" Color="#10FFFFFF" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Border Height="0.25" Margin="0,6.9,0,0" VerticalAlignment="Top" Background="#1E232B" Opacity="0.6" />
            <Path Width="0.8" Height="10" HorizontalAlignment="Right" Data="M0,1.4 H0.8 L0,2.2 Z" Fill="#6E7888" />
            <Border Height="0.8" Margin="0,7,0.8,0" VerticalAlignment="Top" Background="#6E7888" />
            <Path Width="0.8" Height="10" HorizontalAlignment="Right" Data="M0,7 H0.8 L0,7.8 Z" Fill="#6E7888" />
            <Border Height="2.2" Margin="0,0,0.8,0" VerticalAlignment="Top">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Offset="0" Color="#5A626D" />
                  <GradientStop Offset="1" Color="#3A414B" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Border Height="2.2" Margin="0,7.8,0.8,0" VerticalAlignment="Top">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Offset="0" Color="#5A626D" />
                  <GradientStop Offset="1" Color="#3A414B" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Path Width="0.8" Height="10" HorizontalAlignment="Right" Data="M0,0 V2.2 L0.8,1.4 V7 L0,7.8 V10" Stroke="#6E7888" StrokeThickness="0.25" StrokeJoin="Round" />
            <Border Height="0.3" Margin="0,0,0.8,0" VerticalAlignment="Top" Background="#8F99A6" />
            <Border Height="0.3" Margin="0,1.95,0.8,0" VerticalAlignment="Top" Background="#1E232B" Opacity="0.8" />
            <Border Height="0.3" Margin="0,7.8,0.8,0" VerticalAlignment="Top" Background="White" Opacity="0.3" />
            <Border Height="0.25" Margin="0,0,0.8,0" VerticalAlignment="Bottom" Background="#1E232B" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <DataTemplate x:Key="TemplateBlockDetails" x:DataType="models:Blockchain+Block">
      <StackPanel Spacing="12">
        <ItemsControl ItemsSource="{Binding Fields}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Blockchain+Block+Field">
              <Grid ColumnDefinitions="140,*" Margin="0,2">
                <SelectableTextBlock Grid.Column="0" Text="{Binding Name}" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <SelectableTextBlock Text="TXs" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding TXs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Blockchain+TX">
              <Border Classes="Panel" Margin="0,0,0,6">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateTX}" Margin="8" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateAnchor" x:DataType="models:Blockchain+Anchor">
      <Panel Width="72" Height="72" Margin="-20" Classes.glowing="{Binding ReasonForNotGlowing, Converter={x:Static ObjectConverters.IsNull}}" Classes.flying="{Binding IsFlying}">
        <Path Classes="glow" Data="M30,30 L42,30 L42,42 L30,42 Z" Fill="{Binding BrushPair}" Stroke="{Binding BrushPair}" StrokeThickness="5" StrokeJoin="Round" Opacity="0" IsHitTestVisible="False">
          <Path.Effect>
            <BlurEffect Radius="8" />
          </Path.Effect>
        </Path>
        <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button.Flyout>
            <Flyout>
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateFlyoutAnchor}" />
            </Flyout>
          </Button.Flyout>
          <ContentControl Theme="{StaticResource ThemeChip}" BorderBrush="{Binding BrushPair}" Background="{Binding BrushPair}">
            <Path Width="5.4" Height="6.75" Stretch="Uniform" Data="M0.37,1.63 L1.63,0.37 L5.27,0.37 L5.27,5.83 L4.01,7.09 L0.37,7.09 Z M0.37,1.63 L4.01,1.63 L5.27,0.37 M4.01,1.63 L4.01,7.09" Stroke="#FFF6DC" StrokeThickness="0.9" StrokeJoin="Round" />
          </ContentControl>
        </Button>
      </Panel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateChip" x:DataType="models:Blockchain+Chip">
      <Panel Width="32" Height="32" Classes.flying="{Binding IsFlying}" Classes.exploding="{Binding IsExploding}" RenderTransformOrigin="50%,50%">
        <Panel.RenderTransform>
          <ScaleTransform />
        </Panel.RenderTransform>
        <ContentControl Theme="{StaticResource ThemeChip}" BorderBrush="{StaticResource BrushBitcoin}" Background="{StaticResource BrushBitcoin}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path Data="{StaticResource GeometryLogoBitcoin}" Width="6.8" Height="9" Stretch="Uniform" Fill="White" />
        </ContentControl>
        <Path Classes="flash" Data="M10,10 L22,10 L22,22 L10,22 Z" Fill="White" Opacity="0">
          <Path.Effect>
            <BlurEffect Radius="6" />
          </Path.Effect>
        </Path>
      </Panel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateChipTX" x:DataType="models:Blockchain+Chip">
      <Panel Width="32" Height="32">
        <ContentControl Theme="{StaticResource ThemeChip}" BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" Background="{DynamicResource SystemControlHighlightAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path Width="7" Height="7" Stretch="Uniform" Data="M1,2.5 H8 M6,0.5 L8,2.5 L6,4.5 M8,7.5 H1 M3,5.5 L1,7.5 L3,9.5" Stroke="#FFF6DC" StrokeThickness="0.9" StrokeLineCap="Round" StrokeJoin="Round" />
        </ContentControl>
      </Panel>
    </DataTemplate>
    <ControlTheme x:Key="ThemeBlockchain" TargetType="ItemsControl">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Height" Value="98" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ItemsControl">
          <Panel>
            <TemplatedControl Theme="{StaticResource ThemeRail}" />
            <views:RailLights />
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Panel>
        </ControlTemplate>
      </Setter>
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <views:PanelBlocks />
        </ItemsPanelTemplate>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>
  <Border Classes="Panel">
    <Border.Background>
      <RadialGradientBrush Center="100%,0%" GradientOrigin="100%,0%" RadiusX="100%" RadiusY="100%">
        <GradientStop Offset="0" Color="#60FFFFFF" />
        <GradientStop Offset="1" Color="#06FFFFFF" />
      </RadialGradientBrush>
    </Border.Background>
    <DockPanel>
      <ScrollViewer VerticalScrollBarVisibility="Hidden" IsVisible="{Binding BlockchainBToken.IsPlaced}">
        <Panel>
          <Panel.Styles>
            <Style Selector="Path.aluminum">
              <Setter Property="Fill" Value="{StaticResource BrushAluminum}" />
              <Setter Property="Stroke" Value="#3A3F46" />
              <Setter Property="StrokeThickness" Value="0.25" />
              <Setter Property="StrokeJoin" Value="Round" />
            </Style>
            <Style Selector="Path.top">
              <Setter Property="Fill" Value="#66FFFFFF" />
            </Style>
            <Style Selector="Path.side">
              <Setter Property="Fill" Value="#33FFFFFF" />
            </Style>
            <Style Selector="Path.shine">
              <Setter Property="Stroke" Value="White" />
              <Setter Property="StrokeThickness" Value="0.3" />
            </Style>
          </Panel.Styles>
          <Panel.DataTemplates>
            <DataTemplate DataType="models:Blockchain+Anchor">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateAnchor}" />
            </DataTemplate>
            <DataTemplate DataType="models:Blockchain+Chip">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateChip}" />
            </DataTemplate>
          </Panel.DataTemplates>
          <StackPanel Margin="20,0" UseLayoutRounding="False">
            <ItemsControl x:Name="ItemsBlocksBitcoin" ZIndex="1" Theme="{StaticResource ThemeBlockchain}" DataContext="{Binding BlockchainBitcoin}" ItemsSource="{Binding Blocks}" x:DataType="models:Blockchain" Margin="-20,58,0,10">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Blockchain+Block">
                  <views:BlockBitcoin />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid x:Name="GridMining" DataContext="{Binding Mining}" x:DataType="models:Mining">
              <Panel DataContext="{Binding $parent[views:MiningView].((vm:MainViewModel)DataContext).BlockchainBitcoin}" x:DataType="models:Blockchain">
                <ContentControl Theme="{StaticResource ThemeCone}" Margin="0,48,114,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                  <Panel>
                    <Panel IsHitTestVisible="False">
                      <Path Classes="tubeConverter" Data="{StaticResource GeometryTubeConverter}" Stroke="{StaticResource BrushSteel}" StrokeThickness="8" />
                      <Path Data="{StaticResource GeometryTubeConverter}" Stroke="{StaticResource BrushWindowBackground}" StrokeThickness="5" />
                      <Path Data="{StaticResource GeometryTubeConverter}" Stroke="{StaticResource BrushTintGlass}" StrokeThickness="5" Opacity="0.12" />
                    </Panel>
                    <Button Command="{Binding Tank.OpenPanelCommand}" Height="68" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                    <ItemsControl Classes="heap" ItemsSource="{Binding Tank.Chips}" ItemTemplate="{StaticResource TemplateChip}" />
