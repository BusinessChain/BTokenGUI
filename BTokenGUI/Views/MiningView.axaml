                  <Path Data="M72,-21.75 A8,2 0 0 1 64,-23.75 L64,-13.3 A8,2 0 0 0 72,-11.3 Z">
                    <Path.Fill>
                      <LinearGradientBrush StartPoint="64,0" EndPoint="72,0">
                        <GradientStop Offset="0" Color="#19000000" />
