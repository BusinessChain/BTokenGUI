<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BTokenGUI.ViewModels"
             xmlns:models="using:BTokenGUI.Models"
             xmlns:views="using:BTokenGUI.Views"
             x:Class="BTokenGUI.Views.MiningView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <Style Selector="ItemsControl.heap">
      <Setter Property="Clip" Value="M42.372,51.254 A34,8.5 0 1 1 109.628,51.254 L80.451,100.166 L71.549,100.166 Z" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Height" Value="140" />
      <Setter Property="Margin" Value="-40,-40,-40,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="ItemContainerTheme">
        <ControlTheme TargetType="ContentPresenter">
          <Setter Property="Margin" Value="-9.5,-10.5" />
        </ControlTheme>
      </Setter>
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <views:PanelHeap Margin="40" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector=":is(Control).flying">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ItemsControl.flights">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <Canvas />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ItemsControl.flights :is(Control).flying">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Panel.glowing > Path.glow">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Panel.exploding">
      <Style.Animations>
        <Animation Duration="0:0:0.6" FillMode="Forward" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="ScaleTransform.ScaleX" Value="2.5" />
            <Setter Property="ScaleTransform.ScaleY" Value="2.5" />
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Panel.exploding > Path.flash">
      <Style.Animations>
        <Animation Duration="0:0:0.3" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="30%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
