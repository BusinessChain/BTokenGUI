                  <Path Classes="shine" Data="M27.4,-21.75 H54 M72,-21.75 H98.6" />
                  <Path Classes="busbarChip" Data="M20,-6.47 L20,-9.86 A7.4,7.163 0 0 1 27.4,-17.025 L54,-17.025 A6,1.5 0 0 0 60,-18.525 L60,-22.525 A22,5.5 0 0 1 82,-28.025 L147.1,-28.025 A7.4,7.163 0 0 0 154.5,-35.19 L154.5,-37.592 A10.826,4.64 -81.87 0 0 153.082,-44.118 L146.149,-55.012 A4.957,2.124 -81.87 0 1 145.5,-58 L145.5,-73" />
                  <Path Classes="busbarAnchor" Data="M106,-8.39 L106,-9.86 A7.4,7.163 0 0 0 98.6,-17.025 L72,-17.025 A6,1.5 0 0 1 66,-18.525 L66,-22.525 A16,4 0 0 1 82,-26.525 L144.475,-26.525 A7.4,7.163 0 0 0 151.875,-33.69 L151.875,-36.092 A4.957,2.124 -81.87 0 0 151.226,-39.08 L144.293,-49.974 A10.826,4.64 -81.87 0 1 142.875,-56.5 L142.875,-71.5" />
                </Panel>
                <Canvas Width="0" Height="0" Margin="0,48,59,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
                  <Path Classes="pipeAnchor" Data="{StaticResource GeometryPipeAnchor}" Stroke="{StaticResource BrushSteel}" StrokeThickness="8" StrokeJoin="Round" />
                  <Path Data="{StaticResource GeometryPipeAnchor}" Stroke="{StaticResource BrushWindowBackground}" StrokeThickness="5" StrokeJoin="Round" />
                  <Path Data="{StaticResource GeometryPipeAnchor}" Stroke="{StaticResource BrushSteel}" StrokeThickness="5" StrokeJoin="Round" Opacity="0.36" />
                </Canvas>
              </Panel>
              <Panel x:Name="PanelConverter" Width="164" Height="140" Margin="0,114,25,0" HorizontalAlignment="Right" VerticalAlignment="Top" Classes.glowing="{Binding IsMining}">
                <Path Classes="glow" Data="{StaticResource GeometrySphereGlow}" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0" IsHitTestVisible="False">
                  <Path.Effect>
                    <BlurEffect Radius="16" />
                  </Path.Effect>
                </Path>
                <Path Data="{StaticResource GeometrySphere}" Margin="10,10,-10,-10" Fill="Black" Opacity="0.35" IsHitTestVisible="False">
                  <Path.Effect>
                    <BlurEffect Radius="8" />
                  </Path.Effect>
                </Path>
                <TemplatedControl x:Name="PortHatch" Theme="{StaticResource ThemePortBlock}" Margin="72,94,0,0" RenderTransform="rotate(-90deg)" />
                <Panel IsHitTestVisible="False">
                  <Path Data="{StaticResource GeometrySphere}" Fill="{StaticResource BrushWindowBackground}" Opacity="0.6" />
                  <Path Data="{StaticResource GeometrySphere}" Fill="{StaticResource BrushTintGlass}" Opacity="0.12" />
                  <Path Data="M42,70 A40,6 0 0 1 122,70" Stroke="{StaticResource BrushSteel}" StrokeThickness="2" Opacity="0.6" />
                </Panel>
                <Button Command="{Binding OpenFormConverterCommand}" Width="80" Height="80" Margin="42,30,0,0" Padding="0" CornerRadius="40" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Panel IsHitTestVisible="False">
                  <Path Data="{StaticResource GeometrySphere}" Fill="{StaticResource BrushGlass}" />
                  <Path Data="M42,70 A40,6 0 0 0 122,70" Stroke="{StaticResource BrushSteel}" StrokeThickness="2" StrokeLineCap="Round" />
                  <Path Data="{StaticResource GeometrySphere}" Stroke="{StaticResource BrushSteel}" StrokeThickness="2" />
                  <Path Data="M54.3,54 A32,32 0 0 1 71.1,39.9" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" Opacity="0.25" />
                  <Path Data="M58,47 a3,2 0 1 0 6,0 a3,2 0 1 0 -6,0" Fill="White" Opacity="0.5" />
                  <Path Data="M90,85 A9,9 0 1 1 108,85 A9,9 0 1 1 90,85 Z" Stroke="#1A1E25" StrokeThickness="0.5">
                    <Path.Fill>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#E6ECF3" />
                        <GradientStop Offset="1" Color="#6E7888" />
                      </LinearGradientBrush>
                    </Path.Fill>
                  </Path>
                  <Path Data="M91.5,85 A7.5,7.5 0 1 1 106.5,85 A7.5,7.5 0 1 1 91.5,85 Z" Fill="#05070A" />
                  <Path Data="M93.8,88 A6,6 0 1 1 104.2,88" Stroke="{StaticResource BrushSteel}" StrokeThickness="1.2" StrokeLineCap="Round" />
                  <Path Data="M99,85 L99,79.5" Stroke="White" StrokeThickness="1" StrokeLineCap="Round" RenderTransformOrigin="99,85">
                    <Path.RenderTransform>
                      <RotateTransform Angle="{Binding AngleGaugeConverter}" />
                    </Path.RenderTransform>
                  </Path>
                  <Path Data="M97.8,85 a1.2,1.2 0 1 0 2.4,0 a1.2,1.2 0 1 0 -2.4,0" Fill="White" />
                  <Path Data="M92.5,82 A7,7 0 0 1 97,78.3" Stroke="White" StrokeThickness="0.6" StrokeLineCap="Round" Opacity="0.5" />
                  <TemplatedControl Theme="{StaticResource ThemeReceptacle}" Margin="52,30,0,0" />
                  <TemplatedControl Theme="{StaticResource ThemeReceptacle}" Margin="96,30,0,0" />
                  <TemplatedControl Theme="{StaticResource ThemePlug}" Margin="53,22.092,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <TemplatedControl Theme="{StaticResource ThemePlug}" Margin="97,22.092,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </Panel>
              </Panel>
              <ContentControl x:Name="ContentTankPool" Theme="{StaticResource ThemeTankPool}" Margin="0,151,145,0" HorizontalAlignment="Right" VerticalAlignment="Top" DataContext="{Binding $parent[views:MiningView].((vm:MainViewModel)DataContext).BlockchainBToken}" x:DataType="models:Blockchain">
                <ItemsControl x:Name="ItemsTXsPool" Classes="heap" ItemsSource="{Binding TXsPool}" ItemTemplate="{StaticResource TemplateChipTX}" Clip="M57.128,40.418 A34,1.952 -90.982 1 0 58.294,108.37 L97.784,84.702 A11,0.632 -90.982 0 0 97.407,62.718 Z" />
              </ContentControl>
            </Grid>
            <Panel>
              <ItemsControl x:Name="ItemsBlocksBToken" Theme="{StaticResource ThemeBlockchain}" DataContext="{Binding BlockchainBToken}" ItemsSource="{Binding Blocks}" x:DataType="models:Blockchain" Margin="-20,10,0,10">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:Blockchain+Block">
                    <views:BlockBToken BorderBrush="{Binding BrushPair}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <views:BlockBToken Margin="0,10,0,10" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" DataContext="{x:Null}" BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}" />
            </Panel>
            <Panel x:Name="PanelTankBToken" DataContext="{Binding BlockchainBToken}" x:DataType="models:Blockchain" Margin="0,0,0,10">
              <Panel Margin="0,48,76,0" ClipToBounds="True" IsHitTestVisible="False">
                <Canvas>
                  <Grid Width="{Binding #PanelTankBToken.Bounds.Width}" ColumnDefinitions="*,*">
                    <Panel Grid.Column="1" Height="8" Margin="12,100,0,0" VerticalAlignment="Top" Classes.glowing="{Binding Tank.IsAutoActive}">
                      <Border Background="{StaticResource BrushSteel}" />
                      <Border Height="5" Background="{StaticResource BrushWindowBackground}" />
                      <Border Height="5" Background="{StaticResource BrushTintGlass}" Opacity="0.12" />
                      <Path Classes="glow" Data="M0,0 H1 V1 H0 Z" Stretch="Fill" Height="6" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Opacity="0" IsVisible="{Binding Tank.IsAutoToWalletGUI}">
                        <Path.Effect>
                          <BlurEffect Radius="6" />
                        </Path.Effect>
                      </Path>
                    </Panel>
                  </Grid>
                </Canvas>
              </Panel>
              <Panel Width="68" Height="52" Margin="0,126,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Path Data="{StaticResource GeometryWallet}" Margin="-10,10,10,-10" Fill="Black" Opacity="0.35" RenderTransformOrigin="0,0" IsHitTestVisible="False">
                  <Path.RenderTransform>
                    <MatrixTransform Matrix="0.8944,0.1278,0,0.9583,0,0" />
                  </Path.RenderTransform>
                  <Path.Effect>
                    <BlurEffect Radius="8" />
                  </Path.Effect>
                </Path>
                <Panel RenderTransformOrigin="0,0">
                  <Panel.RenderTransform>
                    <MatrixTransform Matrix="0.8944,0.1278,0,0.9583,0,0" />
                  </Panel.RenderTransform>
                  <Button Command="{Binding $parent[views:MiningView].((vm:MainViewModel)DataContext).Wallet.ActivateViewCommand}" Width="64" Height="48" Margin="2,2,0,0" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <Panel IsHitTestVisible="False">
                    <Path Data="{StaticResource GeometryWallet}" Fill="{StaticResource BrushWindowBackground}" />
                    <Path Data="{StaticResource GeometryWallet}" Fill="{StaticResource BrushTintGlass}" Opacity="0.12" />
                    <Path Data="{StaticResource GeometryWallet}" Stroke="{StaticResource BrushSteel}" StrokeThickness="2" StrokeJoin="Round" />
                    <Path Data="M66,14 L46,14 A6,6 0 0 0 40,20 L40,32 A6,6 0 0 0 46,38 L66,38" Stroke="{StaticResource BrushSteel}" StrokeThickness="2" StrokeJoin="Round" />
                    <Path Data="M47,26 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0" Fill="White" Opacity="0.8" />
                  </Panel>
                </Panel>
              </Panel>
              <ContentControl Theme="{StaticResource ThemeCone}" Margin="0,48,12,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Panel Classes.glowing="{Binding Tank.IsAutoActive}">
                  <Panel IsHitTestVisible="False">
                    <Path Data="{StaticResource GeometryTubeCenter}" Stroke="{StaticResource BrushSteel}" StrokeThickness="8" />
                    <Path Data="{StaticResource GeometryTubeAway}" Stroke="{StaticResource BrushSteel}" StrokeThickness="8" OpacityMask="{StaticResource BrushFadeTube}" />
                    <Path Data="{StaticResource GeometryTubeCenter}" Stroke="{StaticResource BrushWindowBackground}" StrokeThickness="5" />
                    <Path Data="{StaticResource GeometryTubeAway}" Stroke="{StaticResource BrushWindowBackground}" StrokeThickness="5" OpacityMask="{StaticResource BrushFadeTube}" />
                    <Path Data="{StaticResource GeometryTubeCenter}" Stroke="{StaticResource BrushTintGlass}" StrokeThickness="5" Opacity="0.12" />
                    <Path Data="{StaticResource GeometryTubeAway}" Stroke="{StaticResource BrushTintGlass}" StrokeThickness="5" Opacity="0.12" OpacityMask="{StaticResource BrushFadeTube}" />
                  </Panel>
                  <Path Classes="glow" Data="{StaticResource GeometryTubeCenter}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="6" Opacity="0" IsVisible="{Binding Tank.IsAutoToWalletGUI}" IsHitTestVisible="False">
                    <Path.Effect>
                      <BlurEffect Radius="6" />
                    </Path.Effect>
                  </Path>
                  <Path Classes="glow" Data="{StaticResource GeometryTubeAway}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="6" Opacity="0" OpacityMask="{StaticResource BrushFadeTube}" IsVisible="{Binding !Tank.IsAutoToWalletGUI}" IsHitTestVisible="False">
                    <Path.Effect>
                      <BlurEffect Radius="6" />
                    </Path.Effect>
                  </Path>
                  <Button Command="{Binding Tank.OpenPanelCommand}" Height="68" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                  <Path Data="{StaticResource GeometryConeInterior}" Fill="#FF8A1F" Opacity="0.9" RenderTransformOrigin="36,60" IsHitTestVisible="False">
                    <Path.RenderTransform>
                      <ScaleTransform ScaleX="{Binding FillingPowder}" ScaleY="{Binding FillingPowder}" />
                    </Path.RenderTransform>
                  </Path>
                  <Path Classes="glow" Data="{StaticResource GeometryCone}" Fill="{DynamicResource SystemControlHighlightAccentBrush}" Stroke="{DynamicResource SystemControlHighlightAccentBrush}" StrokeThickness="4" StrokeJoin="Round" Opacity="0" IsHitTestVisible="False">
                    <Path.Effect>
                      <BlurEffect Radius="10" />
                    </Path.Effect>
                  </Path>
                  <ItemsControl Classes="heap" ItemsSource="{Binding Tank.Chips}" ItemTemplate="{StaticResource TemplateChip}" />
                </Panel>
              </ContentControl>
            </Panel>
          </StackPanel>
          <Canvas x:Name="CanvasFront" IsHitTestVisible="False">
            <Panel x:Name="PanelFlash" Width="320" Height="320" Opacity="0" RenderTransformOrigin="50%,50%">
              <Panel.RenderTransform>
                <ScaleTransform />
              </Panel.RenderTransform>
              <Ellipse Width="320" Height="320">
                <Ellipse.Fill>
                  <RadialGradientBrush>
                    <GradientStop Offset="0" Color="White" />
                    <GradientStop Offset="0.25" Color="#FFF6DC" />
                    <GradientStop Offset="0.55" Color="#A0FF8A1F" />
                    <GradientStop Offset="1" Color="#00FF8A1F" />
                  </RadialGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <Ellipse Width="80" Height="80" Fill="White">
                <Ellipse.Effect>
                  <BlurEffect Radius="16" />
                </Ellipse.Effect>
              </Ellipse>
              <Ellipse Width="200" Height="200" Stroke="White" StrokeThickness="3" Opacity="0.8">
                <Ellipse.Effect>
                  <BlurEffect Radius="3" />
                </Ellipse.Effect>
              </Ellipse>
            </Panel>
          </Canvas>
          <ItemsControl x:Name="ItemsFlights" Classes="flights" ItemsSource="{Binding Mining.Flights}" />
        </Panel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
