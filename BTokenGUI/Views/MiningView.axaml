                        <GradientStop Offset="0.741" Color="#0C000000" />
                        <GradientStop Offset="0.869" Color="#06000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                      </LinearGradientBrush>
                    </Path.Fill>
                  </Path>
