<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BTokenGUI.ViewModels"
             xmlns:models="using:BTokenGUI.Models"
             x:Class="BTokenGUI.Views.AnchorView"
             x:DataType="vm:MainViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="TemplateField" x:DataType="models:Blockchain+Block+Field">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,2">
        <SelectableTextBlock Grid.Column="0" Text="{Binding Value}" TextWrapping="Wrap" />
        <SelectableTextBlock Grid.Column="1" Text="{Binding Name}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="TemplateEntry">
      <Border Classes="Panel" Margin="0,0,0,6">
        <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource TemplateField}" Margin="8" />
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid DataContext="{Binding Mining}" x:DataType="models:Mining" IsVisible="{Binding AnchorShown, Converter={x:Static ObjectConverters.IsNotNull}}">
    <Border Background="#99000000" />
    <Border Classes="Panel" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" MaxWidth="480" Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Center">
      <ScrollViewer>
        <StackPanel Spacing="12" Margin="16">
          <Grid ColumnDefinitions="*,Auto">
            <SelectableTextBlock Grid.Column="0" Text="Anchor TX" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="Close" Command="{Binding CloseAnchorCommand}" />
          </Grid>
          <SelectableTextBlock Text="This anchor missed its Bitcoin block." IsVisible="{Binding AnchorShown.IsMissed, FallbackValue=False}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding AnchorShown.Fields}" ItemTemplate="{StaticResource TemplateField}" />
          <SelectableTextBlock Text="Inputs" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding AnchorShown.Inputs}" ItemTemplate="{StaticResource TemplateEntry}" />
          <SelectableTextBlock Text="Outputs" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding AnchorShown.Outputs}" ItemTemplate="{StaticResource TemplateEntry}" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
