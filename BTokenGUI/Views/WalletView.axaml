<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BTokenGUI.ViewModels"
             xmlns:models="using:BTokenGUI.Models"
             x:Class="BTokenGUI.Views.WalletView"
             x:DataType="vm:MainViewModel">
  <Border Classes="Panel">
    <StackPanel Spacing="6" Margin="20" DataContext="{Binding Wallet}" x:DataType="models:Wallet">
      <SelectableTextBlock Text="Wallet" FontWeight="Bold" Margin="0,0,0,4" />
      <SelectableTextBlock Text="{Binding Address, StringFormat='Address: {0}'}" TextWrapping="Wrap" />
      <SelectableTextBlock Text="{Binding Balance, StringFormat='Balance: {0}'}" TextWrapping="Wrap" />
      <SelectableTextBlock Text="Payment" FontWeight="Bold" Margin="0,10,0,4" />
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
        <SelectableTextBlock Grid.Row="0" Grid.Column="0" Text="Address" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AddressPayee}" />
        <SelectableTextBlock Grid.Row="1" Grid.Column="0" Text="Value" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ValuePayment}" />
        <SelectableTextBlock Grid.Row="2" Grid.Column="0" Text="Fee" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FeePayment}" />
      </Grid>
      <Button Content="Send" Command="{Binding SendPaymentCommand}" />
      <SelectableTextBlock Text="{Binding StatePaymentLast}" TextWrapping="Wrap" />
      <SelectableTextBlock Text="Keys" FontWeight="Bold" Margin="0,10,0,4" />
      <Button Content="Backup" Click="BackupKeys" />
      <SelectableTextBlock Text="{Binding StateBackupLast}" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
