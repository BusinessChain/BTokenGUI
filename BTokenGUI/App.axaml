<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:BTokenGUI.Models"
             x:Class="BTokenGUI.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <SolidColorBrush x:Key="BrushWindowBackground" Color="#090E1A" />
    <DataTemplate x:Key="TemplateField" x:DataType="models:Blockchain+Block+Field">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,2">
        <SelectableTextBlock Grid.Column="0" Text="{Binding Value}" TextWrapping="Wrap" />
        <SelectableTextBlock Grid.Column="1" Text="{Binding Name}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="TemplateEntry">
      <Border Classes="Panel" Margin="0,0,0,6">
        <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource TemplateField}" Margin="8" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="TemplateTX" x:DataType="models:Blockchain+TX">
      <StackPanel Spacing="12">
        <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource TemplateField}" />
        <SelectableTextBlock Text="Inputs" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource TemplateEntry}" />
        <SelectableTextBlock Text="Outputs" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Outputs}" ItemTemplate="{StaticResource TemplateEntry}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="TemplateFlyoutAnchor" x:DataType="models:Blockchain+Anchor">
      <StackPanel Spacing="12" MaxWidth="420">
        <SelectableTextBlock Text="Anchor TX" FontWeight="Bold" />
        <SelectableTextBlock Text="{Binding ReasonForNotGlowing}" IsVisible="{Binding ReasonForNotGlowing, Converter={x:Static ObjectConverters.IsNotNull}}" Foreground="#AC7045" TextWrapping="Wrap" />
        <ContentControl Content="{Binding TX}" ContentTemplate="{StaticResource TemplateTX}" />
      </StackPanel>
    </DataTemplate>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" ErrorText="#FF4040" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="Border.Panel">
      <Setter Property="Background" Value="#10FFFFFF" />
      <Setter Property="BorderBrush" Value="Gray" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Margin" Value="4" />
    </Style>
    <Style Selector="Button.Close">
      <Setter Property="Content" Value="✕" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="TextBox:error,TextBox:error /template/ DataValidationErrors, NumericUpDown:error, NumericUpDown:error /template/ DataValidationErrors, NumericUpDown:error /template/ ButtonSpinner, NumericUpDown:error /template/ ButtonSpinner /template/ DataValidationErrors">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="TextBox:error /template/ Border#PART_BorderElement, NumericUpDown:error /template/ ButtonSpinner /template/ Border">
      <Setter Property="BoxShadow" Value="0 0 8 2 #FF4040, inset 0 0 20 4 #FF4040" />
    </Style>
  </Application.Styles>
</Application>
